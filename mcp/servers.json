{
  "magic": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@21st-dev/magic@latest"
    ],
    "env": {
      "API_KEY": "${MAGIC_API_KEY}"
    }
  },
  "n8n": {
    "type": "http",
    "url": "https://smohaddes.app.n8n.cloud/mcp-server/http",
    "headers": {
      "Authorization": "Bearer ${N8N_MCP_TOKEN}"
    }
  },
  "shadcn": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "shadcn@latest",
      "mcp"
    ],
    "env": {}
  },
  "pollinations-images": {
    "type": "stdio",
    "command": "npx",
    "args": [
      "-y",
      "@pollinations/model-context-protocol"
    ],
    "env": {}
  }
}