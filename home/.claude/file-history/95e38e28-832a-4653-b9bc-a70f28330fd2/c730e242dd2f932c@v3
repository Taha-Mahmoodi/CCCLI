  <div class="article-hero-vis">
    <div class="article-hero-image" aria-hidden="true" style="background-image: linear-gradient(180deg, rgba(13,4,16,.15) 40%, rgba(13,4,16,.65) 100%), url('/images/generated/blog-third-eye-kit-v2.jpg')">
