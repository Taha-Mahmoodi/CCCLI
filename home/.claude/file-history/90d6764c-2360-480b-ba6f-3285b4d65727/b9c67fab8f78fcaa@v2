import sys, os, json, base64, subprocess

def gh_json(path):
    out = subprocess.run(["gh", "api", path], capture_output=True, text=True, check=True)
    return json.loads(out.stdout)

def install(owner_repo, src_path, dest_name, branch="main"):
    tree = gh_json(f"repos/{owner_repo}/git/trees/{branch}?recursive=1")["tree"]
    base = f"/Users/taha/.agents/skills/{dest_name}"
    files = [t for t in tree if t["type"] == "blob" and t["path"].startswith(src_path + "/")]
    if not files:
        print(f"NO FILES FOUND for {owner_repo}:{src_path}", file=sys.stderr)
        return
    for t in files:
        rel = t["path"][len(src_path) + 1:]
        dest = os.path.join(base, rel)
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        blob = gh_json(f"repos/{owner_repo}/git/blobs/{t['sha']}")
        content = base64.b64decode(blob["content"])
        with open(dest, "wb") as f:
            f.write(content)
    link = f"/Users/taha/.claude/skills/{dest_name}"
    if os.path.islink(link) or os.path.exists(link):
        os.remove(link)
    os.symlink(f"../../.agents/skills/{dest_name}", link)
    print(f"installed {dest_name}: {len(files)} files")

if __name__ == "__main__":
    owner_repo, src_path, dest_name = sys.argv[1], sys.argv[2], sys.argv[3]
    branch = sys.argv[4] if len(sys.argv) > 4 else "main"
    install(owner_repo, src_path, dest_name, branch)
