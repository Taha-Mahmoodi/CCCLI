import json, math

d = json.load(open('/private/tmp/claude-501/-Users-taha/51b90afe-944f-4f8c-a234-21ade39239a8/scratchpad/contributions.json'))
weeks = d['data']['user']['contributionsCollection']['contributionCalendar']['weeks']
days = [day for w in weeks for day in w['contributionDays']]
n = len(days)
max_count = max(day['contributionCount'] for day in days)

W, H = 900, 500
cx, cy = W / 2, H / 2
max_radius = min(W, H) / 2 - 30
turns = 3.2

def star_size(count):
    if count == 0:
        return 0
    return 1.6 + 5.4 * (math.log(count + 1) / math.log(max_count + 1))

def star_opacity(count):
    if count == 0:
        return 0
    return 0.45 + 0.55 * (math.log(count + 1) / math.log(max_count + 1))

svg_parts = []
svg_parts.append(f'<svg width="{W}" height="{H}" viewBox="0 0 {W} {H}" xmlns="http://www.w3.org/2000/svg">')
svg_parts.append('''<defs>
  <radialGradient id="bg" cx="50%" cy="50%" r="75%">
    <stop offset="0%" stop-color="#161b2e"/>
    <stop offset="100%" stop-color="#05060d"/>
  </radialGradient>
  <filter id="glow" x="-200%" y="-200%" width="500%" height="500%">
    <feGaussianBlur stdDeviation="3.2" result="blur"/>
    <feMerge>
      <feMergeNode in="blur"/>
      <feMergeNode in="SourceGraphic"/>
    </feMerge>
  </filter>
</defs>''')
svg_parts.append(f'<rect width="{W}" height="{H}" fill="url(#bg)"/>')

# faint background texture stars, purely decorative, dim and small, no glow
import random
rnd = random.Random(42)
for _ in range(140):
    x = rnd.uniform(0, W)
    y = rnd.uniform(0, H)
    r = rnd.uniform(0.3, 0.9)
    o = rnd.uniform(0.08, 0.25)
    svg_parts.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="{r:.2f}" fill="#8fa3c7" opacity="{o:.2f}"/>')

# spiral arm guide, very faint
spiral_pts = []
for i in range(400):
    t = i / 399
    angle = t * turns * 2 * math.pi
    radius = t * max_radius
    x = cx + radius * math.cos(angle)
    y = cy + radius * math.sin(angle)
    spiral_pts.append(f"{x:.1f},{y:.1f}")
svg_parts.append(f'<polyline points="{" ".join(spiral_pts)}" fill="none" stroke="#6C63FF" stroke-width="0.6" opacity="0.14"/>')

# real contribution days as stars along the spiral, oldest at center, most recent at the edge
for i, day in enumerate(days):
    count = day['contributionCount']
    if count == 0:
        continue
    t = i / (n - 1)
    angle = t * turns * 2 * math.pi
    radius = t * max_radius
    x = cx + radius * math.cos(angle)
    y = cy + radius * math.sin(angle)
    size = star_size(count)
    op = star_opacity(count)
    color = "#ffffff" if count >= max_count * 0.6 else "#b9b3ff" if count >= max_count * 0.2 else "#6C63FF"
    svg_parts.append(f'<circle cx="{x:.1f}" cy="{y:.1f}" r="{size:.2f}" fill="{color}" opacity="{op:.2f}" filter="url(#glow)"/>')

svg_parts.append(f'<text x="{W/2}" y="30" text-anchor="middle" font-family="Fira Code, monospace" font-size="15" fill="#c9d1d9">A year of commits, one star per day</text>')
svg_parts.append(f'<text x="{W/2}" y="{H-16}" text-anchor="middle" font-family="Fira Code, monospace" font-size="11" fill="#6b7280">{sum(1 for day in days if day["contributionCount"]>0)} active days &#183; {sum(day["contributionCount"] for day in days)} contributions &#183; brightest day {max_count}</text>')
svg_parts.append('</svg>')

with open('/private/tmp/claude-501/-Users-taha/51b90afe-944f-4f8c-a234-21ade39239a8/scratchpad/constellation.svg', 'w') as f:
    f.write('\n'.join(svg_parts))

print("done")
