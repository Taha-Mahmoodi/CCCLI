import math

W, H = 900, 240
FONT = 'SFMono-Regular, Menlo, Consolas, monospace'
MAG = '#E24A94'      # brightened TEWW magenta for AA contrast on dark
CY = 120
N = 46
band_x0, band_x1 = 60, W - 60
bar_w = 5
gap = (band_x1 - band_x0 - N * bar_w) / (N - 1)

# base heights follow a couple of sine envelopes → looks like a voice waveform
def base_h(i):
    t = i / (N - 1)
    env = 0.35 + 0.65 * abs(math.sin(t * math.pi * 3.2) * math.cos(t * math.pi * 1.3))
    return 14 + env * 66

p = [f'<svg width="{W}" height="{H}" viewBox="0 0 {W} {H}" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Said Mohaddes Sadeqi — building a world beyond vision">']
p.append('<title>Said Mohaddes Sadeqi — building voice-first, accessible technology</title>')
p.append('''<style>
  .bar { transform-box: fill-box; transform-origin: center; animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 0%,100% { transform: scaleY(0.35); } 50% { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) { .bar { animation: none !important; transform: none !important; } }
</style>''')
p.append(f'<rect width="{W}" height="{H}" fill="#0c0c11"/>')
# center guide line
p.append(f'<line x1="{band_x0}" y1="{CY}" x2="{band_x1}" y2="{CY}" stroke="#2a2a33" stroke-width="1"/>')

# waveform bars, symmetric around CY, CSS-animated with staggered delay
for i in range(N):
    x = band_x0 + i * (bar_w + gap)
    h = base_h(i)
    y = CY - h / 2
    delay = (i % 12) * 0.11
    col = MAG if i % 3 == 0 else '#8A8FF0' if i % 3 == 1 else '#cfd2e6'
    p.append(f'<rect class="bar" x="{x:.1f}" y="{y:.1f}" width="{bar_w}" height="{h:.1f}" rx="2.5" '
             f'fill="{col}" style="animation-delay:{delay:.2f}s"/>')

# text — high contrast white on near-black (>15:1)
p.append(f'<text x="{W/2}" y="{H-52}" text-anchor="middle" font-family="{FONT}" font-size="24" font-weight="700" fill="#ffffff">Said Mohaddes Sadeqi</text>')
p.append(f'<text x="{W/2}" y="{H-28}" text-anchor="middle" font-family="{FONT}" font-size="13" fill="#b9bccb">Voice-first AI for blind users &#183; a world beyond vision</text>')
# top-left mark
p.append(f'<text x="34" y="42" font-family="{FONT}" font-size="13" fill="{MAG}">// third eye worldwide</text>')

p.append('</svg>')
open('/private/tmp/claude-501/-Users-taha/51b90afe-944f-4f8c-a234-21ade39239a8/scratchpad/sadeq_header.svg','w').write('\n'.join(p))
print('done')
