for fname, program, university, loc, hook, conn, fit, bg_k, work_k, proj_k, close_k, note in ENTRIES:
    body = f"""STATEMENT OF PURPOSE

Applicant: Taha Mahmoodi (Afghan national)
Program: {program}
University: {university}
Location: {loc}

Dear Admissions Committee,

{hook} {conn}

{BG[bg_k]}

{WORK[work_k]}

{PROJ[proj_k]}

{fit}

{CLOSE[close_k]}

Sincerely,
Taha Mahmoodi
"""
    if note:
        body += f"\n[Note to self before submitting: {note}]\n"

    path = os.path.join(OUT_DIR, fname + ".txt")
    with open(path, "w", encoding="utf-8") as f:
        f.write(body)

    # Markdown version for PDF rendering
    md_paras = "\n\n".join([
        f"{hook} {conn}",
        BG[bg_k],
        WORK[work_k],
        PROJ[proj_k],
        fit,
        CLOSE[close_k],
    ])
    md = f"""# Statement of Purpose

**Applicant:** Taha Mahmoodi (Afghan national)
**Program:** {program}
**University:** {university}
**Location:** {loc}

---

Dear Admissions Committee,

{md_paras}

Sincerely,
Taha Mahmoodi
"""
    if note:
        md += f"\n> **Note before submitting:** {note}\n"

    md_path = os.path.join(MD_DIR, fname + ".md")
    with open(md_path, "w", encoding="utf-8") as f:
        f.write(md)

    pdf_path = os.path.join(PDF_DIR, fname + ".pdf")
    title = f"{university} — Statement of Purpose"
    result = subprocess.run(
        [PDF_BIN, "generate", "--no-confidential", "--author", "Taha Mahmoodi",
         "--title", title, md_path, pdf_path],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"FAILED: {fname}", file=sys.stderr)
        print(result.stderr, file=sys.stderr)
    else:
        print(f"OK: {pdf_path}")

print(f"Wrote {len(ENTRIES)} letters (.txt + .md) and rendered PDFs to {PDF_DIR}")
