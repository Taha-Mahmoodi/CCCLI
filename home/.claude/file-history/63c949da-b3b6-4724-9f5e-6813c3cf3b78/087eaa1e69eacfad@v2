<title>Turkish CE Master's Programs — Application Tracker</title>
<style>
  :root {
    --paper: #edeee6;
    --paper-raised: #f6f6f0;
    --ink: #1b2321;
    --ink-soft: #4a5049;
    --muted: #7a7d6f;
    --line: #d3d2c4;
    --accent: #2b6e62;
    --accent-soft: #dde8e3;
    --warm: #a8452f;
    --warm-soft: #f1ddd4;
    --closed: #86847a;
    --closed-soft: #e4e3d8;
    --focus: #1c5c86;
  }

  :root[data-theme="dark"] {
    --paper: #14181a;
    --paper-raised: #1b2124;
    --ink: #e9ebe4;
    --ink-soft: #b7bcae;
    --muted: #82887a;
    --line: #2c332f;
    --accent: #6bbfa8;
    --accent-soft: #1c2e29;
    --warm: #e08361;
    --warm-soft: #33231b;
    --closed: #8b9086;
    --closed-soft: #22261f;
    --focus: #7fb8e0;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --paper: #14181a;
      --paper-raised: #1b2124;
      --ink: #e9ebe4;
      --ink-soft: #b7bcae;
      --muted: #82887a;
      --line: #2c332f;
      --accent: #6bbfa8;
      --accent-soft: #1c2e29;
      --warm: #e08361;
      --warm-soft: #33231b;
      --closed: #8b9086;
      --closed-soft: #22261f;
      --focus: #7fb8e0;
    }
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .page {
    max-width: 920px;
    margin: 0 auto;
    padding: 56px 28px 96px;
  }

  header.masthead {
    border-bottom: 2px solid var(--ink);
    padding-bottom: 22px;
    margin-bottom: 8px;
  }

  .eyebrow {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 10px;
  }

  h1 {
    font-family: Georgia, "Iowan Old Style", "Palatino Linotype", "Times New Roman", serif;
    font-size: clamp(30px, 4.2vw, 42px);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 12px;
    text-wrap: balance;
  }

  .dek {
    max-width: 62ch;
    color: var(--ink-soft);
    font-size: 16px;
    margin: 0 0 4px;
  }

  .meta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin-top: 18px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12.5px;
    color: var(--muted);
  }

  .meta-row b { color: var(--ink-soft); font-weight: 600; }

  section.tier {
    margin-top: 44px;
  }

  .tier-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 4px;
  }

  .tier-head h2 {
    font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif;
    font-size: 21px;
    font-weight: 600;
    margin: 0;
  }

  .tier-count {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 12px;
    color: var(--muted);
  }

  .tier-note {
    color: var(--ink-soft);
    font-size: 14.5px;
    max-width: 68ch;
    margin: 6px 0 20px;
  }

  .cards {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .card {
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 3px;
    padding: 16px 20px;
    display: grid;
    grid-template-columns: 1.6fr 1fr auto;
    gap: 16px;
    align-items: start;
  }

  .card .who h3 {
    font-family: Georgia, "Iowan Old Style", "Palatino Linotype", serif;
    font-size: 17px;
    font-weight: 600;
    margin: 0 0 3px;
  }

  .card .who .program {
    font-size: 13.5px;
    color: var(--ink-soft);
  }

  .card .who .location {
    font-size: 12px;
    color: var(--muted);
    margin-top: 3px;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 20px;
    width: fit-content;
    margin-bottom: 8px;
  }

  .status::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .status.open { background: var(--accent-soft); color: var(--accent); }
  .status.urgent { background: var(--warm-soft); color: var(--warm); }
  .status.closed { background: var(--closed-soft); color: var(--closed); }

  .dates {
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
    font-variant-numeric: tabular-nums;
    font-size: 12.5px;
    color: var(--ink-soft);
    line-height: 1.55;
  }

  .dates .label {
    color: var(--muted);
    display: inline-block;
    min-width: 62px;
  }

  .links {
    display: flex;
    flex-direction: column;
    gap: 7px;
    align-items: flex-end;
    text-align: right;
    min-width: 118px;
  }

  .links a {
    font-size: 12.5px;
    color: var(--focus);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    white-space: nowrap;
  }

  .links a:hover,
  .links a:focus-visible {
    border-bottom-color: var(--focus);
  }

  .links a:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
    border-radius: 2px;
  }

  .links a::after {
    content: " ↗";
  }

  .verify {
    grid-column: 1 / -1;
    font-size: 12px;
    color: var(--warm);
    background: var(--warm-soft);
    border-radius: 2px;
    padding: 6px 10px;
    margin-top: 2px;
  }

  footer.notes {
    margin-top: 52px;
    padding-top: 22px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
    max-width: 68ch;
  }

  footer.notes h2 {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin: 0 0 8px;
  }

  footer.notes ul {
    margin: 0;
    padding-left: 18px;
  }

  footer.notes li { margin-bottom: 6px; }

  @media (max-width: 720px) {
    .card {
      grid-template-columns: 1fr;
    }
    .links {
      align-items: flex-start;
      text-align: left;
      flex-direction: row;
      flex-wrap: wrap;
    }
  }
</style>

