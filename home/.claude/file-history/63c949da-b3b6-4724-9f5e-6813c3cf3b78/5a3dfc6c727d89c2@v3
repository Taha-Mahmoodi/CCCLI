# Generate letters
for program_file, program_name, university, location, category in PROGRAMS:
    for rec in RECOMMENDERS:
        fname = f"{program_file}_rec{RECOMMENDERS.index(rec) + 1}_{rec['name'].replace(' ', '_')}"

        template_body = rec["templates"][category]

        letter_body = f"""{rec['intro']} I would like to speak specifically to what I have observed of Taha's capabilities in the context of your program.

{template_body}

{rec['closing']}

Sincerely,
{rec['name']}
{rec['title']}
"""

        # Write text version
        txt_path = os.path.join(REC_DIR, fname + ".txt")
        with open(txt_path, "w", encoding="utf-8") as f:
            f.write(letter_body)

        # Create markdown for PDF
        md_body = f"""# Recommendation Letter

**Candidate:** Taha Mahmoodi (Afghan national)
**Program:** {program_name}
**University:** {university}
**Location:** {location}

**Recommender:** {rec['name']}
{rec['title']}

---

{rec['intro']} I would like to speak specifically to what I have observed of Taha's capabilities in the context of your program.

{template_body}

{rec['closing']}

Sincerely,

{rec['name']}
"""

        md_path = os.path.join(REC_DIR, fname + ".md")
        with open(md_path, "w", encoding="utf-8") as f:
            f.write(md_body)

        # Render PDF
        pdf_path = os.path.join(PDF_DIR, fname + ".pdf")
        title = f"{university} — Recommendation Letter for Taha Mahmoodi"
        result = subprocess.run(
            [PDF_BIN, "generate", "--no-confidential", "--author", rec['name'],
             "--title", title, md_path, pdf_path],
            capture_output=True, text=True,
        )
        if result.returncode != 0:
            print(f"FAILED: {fname}", file=__import__('sys').stderr)
            print(result.stderr, file=__import__('sys').stderr)
        else:
            print(f"OK: {pdf_path}")

print(f"Wrote {len(PROGRAMS) * len(RECOMMENDERS)} recommendation letters to {REC_DIR}")
