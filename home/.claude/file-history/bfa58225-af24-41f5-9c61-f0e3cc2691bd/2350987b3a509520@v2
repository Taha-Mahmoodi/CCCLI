// tablet/src/visits/CheckInOutScreen.tsx
import { useEffect, useState } from 'react'
import { checkIn, checkOut, listVisits } from '../api/visits'
import type { Visit } from '../api/types'
import { enqueue, getQueue } from '../offline/queueStore'
import { getLatestLocation } from '../location/locationStore'

export function CheckInOutScreen() {
  const [openVisit, setOpenVisit] = useState<Visit | null>(null)
  const [pendingCheckIn, setPendingCheckIn] = useState(false)
  const [pendingCheckOut, setPendingCheckOut] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [loading, setLoading] = useState(true)

  async function refresh() {
    const queue = await getQueue()
    setPendingCheckIn(queue.some((a) => a.type === 'check_in'))
    setPendingCheckOut(queue.some((a) => a.type === 'check_out'))
    try {
      const visits = await listVisits(1, 0)
      setOpenVisit(visits.find((v) => v.checked_out_at === null) ?? null)
    } catch {
      // Offline or request failed -- fall back to whatever the queue says.
    }
    setLoading(false)
  }

  useEffect(() => {
    refresh()
  }, [])

  // While a check-in/out is pending sync, poll so the screen picks up the
  // real result once useSyncQueue's background flush confirms it -- that
  // flush runs independently of whichever screen happens to be mounted.
  useEffect(() => {
    if (!pendingCheckIn && !pendingCheckOut) return
    const id = setInterval(refresh, 5000)
    return () => clearInterval(id)
  }, [pendingCheckIn, pendingCheckOut])

  async function handleCheckIn() {
    setError(null)
    const location = getLatestLocation()
    if (!location) {
      setError('No location available yet -- start tracking first.')
      return
    }
    const idempotencyKey = crypto.randomUUID()
    const input = { idempotency_key: idempotencyKey, latitude: location.latitude, longitude: location.longitude }
    try {
      const visit = await checkIn(input)
      setOpenVisit(visit)
    } catch {
      await enqueue({ id: idempotencyKey, type: 'check_in', queuedAt: new Date().toISOString(), payload: input })
      setPendingCheckIn(true)
    }
  }

  async function handleCheckOut() {
    if (!openVisit) return
    setError(null)
    try {
      await checkOut(openVisit.id)
      setOpenVisit(null) // this visit is now closed -- next action is a fresh check-in, not another check-out
    } catch {
      await enqueue({
        id: crypto.randomUUID(),
        type: 'check_out',
        queuedAt: new Date().toISOString(),
        payload: { visitId: openVisit.id },
      })
      setPendingCheckOut(true)
    }
  }

  if (loading) return <div className="p-8 text-gray-500">Loading…</div>

  return (
    <div className="p-8">
      <h2 className="text-xl font-semibold text-gray-900 mb-4">Visit</h2>
      {pendingCheckIn ? (
        <p className="text-sm text-gray-600">Checked in -- syncing…</p>
      ) : openVisit ? (
        <button
          onClick={handleCheckOut}
          disabled={pendingCheckOut}
          className="px-4 py-2 rounded text-white bg-red-600 disabled:opacity-50"
        >
          {pendingCheckOut ? 'Checking out -- syncing…' : 'Check out'}
        </button>
      ) : (
        <button onClick={handleCheckIn} className="px-4 py-2 rounded text-white bg-blue-600">
          Check in
        </button>
      )}
      {error && <p className="mt-4 text-sm text-red-600">{error}</p>}
    </div>
  )
}
```

Note the asymmetry between the two success paths: `handleCheckIn` does `setOpenVisit(visit)` (the newly-created visit IS the open one), but `handleCheckOut` does `setOpenVisit(null)` (the visit just closed, so there is no longer an open one — assigning the closed `Visit` object back into `openVisit` would leave the "Check out" button rendered and enabled for an already-closed visit, and a second tap would 409). Don't "simplify" this to `setOpenVisit(await checkOut(...))` — it looks more consistent but is wrong.

