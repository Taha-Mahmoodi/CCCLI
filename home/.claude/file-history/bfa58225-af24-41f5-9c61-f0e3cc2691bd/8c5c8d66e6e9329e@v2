// dashboard/src/zones/ZonesPage.tsx
import { MapContainer, TileLayer, Polygon, useMap } from 'react-leaflet'
import { useCallback, useEffect, useState } from 'react'
import L from 'leaflet'
import 'leaflet-draw'
import 'leaflet-draw/dist/leaflet.draw.css'
import { assignRepToZone, createZone, getZoneAssignments, getZones } from '../api/zones'
import { getUsers } from '../api/users'
import type { GeoJSONPolygon, User, Zone, ZoneAssignment } from '../api/types'

const DEFAULT_CENTER: [number, number] = [0, 0]
const DEFAULT_ZOOM = 3

function DrawControl({ onCreated }: { onCreated: (boundary: GeoJSONPolygon) => void }) {
  const map = useMap()

  useEffect(() => {
    const drawnItems = new L.FeatureGroup()
    map.addLayer(drawnItems)

    const drawControl = new L.Control.Draw({
      draw: {
        polygon: {},
        marker: false,
        circle: false,
        circlemarker: false,
        polyline: false,
        rectangle: false,
      },
      edit: { featureGroup: drawnItems },
    })
    map.addControl(drawControl)

    function handleCreated(event: L.LeafletEvent) {
      const layer = (event as L.DrawEvents.Created).layer as L.Polygon
      drawnItems.addLayer(layer)
      const feature = layer.toGeoJSON()
      onCreated(feature.geometry as unknown as GeoJSONPolygon)
      drawnItems.removeLayer(layer)
    }

    map.on(L.Draw.Event.CREATED, handleCreated)
    return () => {
      map.off(L.Draw.Event.CREATED, handleCreated)
      map.removeControl(drawControl)
      map.removeLayer(drawnItems)
    }
  }, [map, onCreated])

  return null
}

export function ZonesPage() {
  const [zones, setZones] = useState<Zone[]>([])
  const [reps, setReps] = useState<User[]>([])
  const [selectedZoneId, setSelectedZoneId] = useState<string | null>(null)
  const [assignments, setAssignments] = useState<ZoneAssignment[]>([])
  const [selectedRepId, setSelectedRepId] = useState('')

  const refreshZones = useCallback(() => {
    getZones().then(setZones).catch(() => {})
  }, [])

  useEffect(() => {
    refreshZones()
    getUsers('rep').then(setReps).catch(() => {})
  }, [refreshZones])

  useEffect(() => {
    if (!selectedZoneId) {
      setAssignments([])
      return
    }
    getZoneAssignments(selectedZoneId).then(setAssignments).catch(() => {})
  }, [selectedZoneId])

  const repEmailById = new Map(reps.map((rep) => [rep.id, rep.email]))

  async function handleCreated(boundary: GeoJSONPolygon) {
    const name = window.prompt('Zone name:')
    if (!name) return
    await createZone(name, boundary)
    refreshZones()
  }

  async function handleAssign() {
    if (!selectedZoneId || !selectedRepId) return
    await assignRepToZone(selectedZoneId, selectedRepId)
    const updated = await getZoneAssignments(selectedZoneId)
    setAssignments(updated)
    setSelectedRepId('')
  }

  return (
    <div className="flex h-[calc(100vh-57px)]">
      <div className="flex-1">
        <MapContainer center={DEFAULT_CENTER} zoom={DEFAULT_ZOOM} className="h-full w-full">
          <TileLayer
            url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
            attribution="&copy; OpenStreetMap contributors"
          />
          {zones.map((zone) => (
            <Polygon
              key={zone.id}
              positions={zone.boundary.coordinates[0].map(([lng, lat]) => [lat, lng] as [number, number])}
              eventHandlers={{ click: () => setSelectedZoneId(zone.id) }}
            />
          ))}
          <DrawControl onCreated={handleCreated} />
        </MapContainer>
      </div>
      <div className="w-80 bg-white border-l border-gray-200 p-4 overflow-y-auto">
        <h2 className="font-semibold text-gray-900 mb-2">Zones</h2>
        <ul className="mb-4">
          {zones.map((zone) => (
            <li key={zone.id}>
              <button
                onClick={() => setSelectedZoneId(zone.id)}
                className={`block w-full text-left px-2 py-1 rounded ${
                  selectedZoneId === zone.id ? 'bg-blue-50 text-blue-700' : 'text-gray-700 hover:bg-gray-50'
                }`}
              >
                {zone.name}
              </button>
            </li>
          ))}
        </ul>
        {selectedZoneId ? (
          <div>
            <h3 className="font-medium text-gray-900 mb-2">Assignments</h3>
            <ul className="mb-2 text-sm text-gray-600">
              {assignments.map((assignment) => (
                <li key={assignment.id}>{repEmailById.get(assignment.rep_id) ?? assignment.rep_id}</li>
              ))}
              {assignments.length === 0 && <li className="text-gray-400">No reps assigned</li>}
            </ul>
            <div className="flex gap-2">
              <select
                value={selectedRepId}
                onChange={(event) => setSelectedRepId(event.target.value)}
                className="flex-1 border border-gray-300 rounded px-2 py-1 text-sm"
              >
                <option value="">Select a rep…</option>
                {reps.map((rep) => (
                  <option key={rep.id} value={rep.id}>
                    {rep.email}
                  </option>
                ))}
              </select>
              <button
                onClick={handleAssign}
                disabled={!selectedRepId}
                className="px-3 py-1 bg-blue-600 text-white rounded text-sm disabled:opacity-50"
              >
                Assign
              </button>
            </div>
          </div>
        ) : (
          <p className="text-sm text-gray-400">Select a zone to manage assignments, or draw a new one on the map.</p>
        )}
      </div>
    </div>
  )
}
```

Note the `positions` prop's coordinate-order flip: `zone.boundary.coordinates[0]` is `[lng, lat]` pairs (GeoJSON order, matching the backend's stored `Zone.boundary` and everything this codebase's backend geofencing logic already does), but `react-leaflet`'s `Polygon` `positions` prop wants `[lat, lng]` — this is a THIRD place in this project (after `app/core/geo.py` and `visits/service.py::check_in` on the backend) where getting this order backwards silently produces a wrong-shaped-but-still-rendering polygon. The `.map(([lng, lat]) => [lat, lng])` line is the fix; if a reviewer or the controller's browser check sees a zone polygon rendered in the wrong place/shape (e.g. rotated 90°, or off in the ocean when it should be on land), check this line first.

