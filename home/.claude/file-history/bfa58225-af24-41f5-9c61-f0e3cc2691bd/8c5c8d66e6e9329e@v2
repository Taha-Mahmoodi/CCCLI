// dashboard/src/push/PushOptInButton.tsx
import { useState } from 'react'
import { subscribeToPushNotifications } from './subscribeToPush'

export function PushOptInButton() {
  const [status, setStatus] = useState<'idle' | 'loading' | 'done' | 'error'>('idle')
  const [errorMessage, setErrorMessage] = useState('')

  async function handleClick() {
    setStatus('loading')
    try {
      await subscribeToPushNotifications()
      setStatus('done')
    } catch (error) {
      setStatus('error')
      setErrorMessage(error instanceof Error ? error.message : 'Failed to enable alerts.')
    }
  }

  if (status === 'done') {
    return <span className="text-sm text-green-700">Alerts enabled</span>
  }

  return (
    <div className="flex items-center gap-2">
      <button
        onClick={handleClick}
        disabled={status === 'loading'}
        className="text-sm text-gray-600 hover:text-gray-900 disabled:opacity-50"
      >
        {status === 'loading' ? 'Enabling…' : 'Enable violation alerts'}
      </button>
      {status === 'error' && <span className="text-xs text-red-600">{errorMessage}</span>}
    </div>
  )
}
