```ts
// dashboard/src/push/subscribeToPush.ts
import { createPushSubscription, getVapidPublicKey } from '../api/pushSubscriptions'

function urlBase64ToUint8Array(base64String: string): Uint8Array {
  const padding = '='.repeat((4 - (base64String.length % 4)) % 4)
  const base64 = (base64String + padding).replace(/-/g, '+').replace(/_/g, '/')
  const rawData = window.atob(base64)
  return Uint8Array.from([...rawData].map((char) => char.charCodeAt(0)))
}

export async function subscribeToPushNotifications(): Promise<void> {
  if (!('serviceWorker' in navigator) || !('PushManager' in window)) {
    throw new Error('Push notifications are not supported in this browser.')
  }

  const registration = await navigator.serviceWorker.register('/sw.js')
  const { vapid_public_key: vapidPublicKey } = await getVapidPublicKey()
  if (!vapidPublicKey) {
    throw new Error('Push is not configured on the server yet.')
  }

  const subscription = await registration.pushManager.subscribe({
    userVisibleOnly: true,
    applicationServerKey: urlBase64ToUint8Array(vapidPublicKey),
  })

  const raw = subscription.toJSON()
  if (!raw.endpoint || !raw.keys?.p256dh || !raw.keys?.auth) {
    throw new Error('Browser did not return a complete push subscription.')
  }

  await createPushSubscription({
    endpoint: raw.endpoint,
    p256dh: raw.keys.p256dh,
    auth: raw.keys.auth,
  })
}
```

`urlBase64ToUint8Array` exists because VAPID public keys are transmitted as URL-safe base64 strings but `PushManager.subscribe`'s `applicationServerKey` option needs raw bytes (a `Uint8Array`/`BufferSource`) — this is the standard, well-known conversion every Web Push tutorial uses; it is not custom cryptography, just base64 decoding with the URL-safe alphabet normalized back to standard base64 first.

