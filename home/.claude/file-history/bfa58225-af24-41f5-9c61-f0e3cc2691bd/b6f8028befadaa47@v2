import { MapContainer, TileLayer, Marker, Popup } from 'react-leaflet'
import { useEffect, useState } from 'react'
import { getLatestPings } from '../api/pings'
import { getUsers } from '../api/users'
import { usePolling } from './usePolling'
import type { LatestPing, User } from '../api/types'

const MAP_POLL_INTERVAL_MS = 20_000
const DEFAULT_CENTER: [number, number] = [0, 0]
const DEFAULT_ZOOM = 3

export function MapView() {
  const { data: pings, error } = usePolling<LatestPing[]>(getLatestPings, MAP_POLL_INTERVAL_MS)
  const [reps, setReps] = useState<User[]>([])

  useEffect(() => {
    getUsers('rep').then(setReps).catch(() => {})
  }, [])

  const repEmailById = new Map(reps.map((rep) => [rep.id, rep.email]))

  return (
    <div className="h-screen w-screen">
      {error && <div className="absolute z-10 bg-red-100 text-red-800 p-2">Failed to load positions</div>}
      <MapContainer center={DEFAULT_CENTER} zoom={DEFAULT_ZOOM} className="h-full w-full">
        <TileLayer
          url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
          attribution="&copy; OpenStreetMap contributors"
        />
        {(pings ?? []).map((ping) => (
          <Marker key={ping.rep_id} position={[ping.latitude, ping.longitude]}>
            <Popup>
              <div>{repEmailById.get(ping.rep_id) ?? ping.rep_id}</div>
              <div className="text-xs text-gray-500">Last seen: {new Date(ping.recorded_at).toLocaleString()}</div>
            </Popup>
          </Marker>
        ))}
      </MapContainer>
    </div>
  )
}
```

