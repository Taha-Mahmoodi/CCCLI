```python
from fastapi import APIRouter, Depends, HTTPException, Query, Response, status
```

```python
@router.post("/check-in", response_model=VisitOut)
async def check_in_endpoint(
    body: VisitCheckIn,
    response: Response,
    current_user: User = Depends(require_rep),
    db: AsyncSession = Depends(get_db),
) -> VisitOut:
    try:
        visit, created = await check_in(
            db,
            tenant_id=current_user.tenant_id,
            rep_id=current_user.id,
            latitude=body.latitude,
            longitude=body.longitude,
            idempotency_key=body.idempotency_key,
            zone_id=body.zone_id,
            notes=body.notes,
            external_reference=body.external_reference,
        )
    except ZoneNotFoundError as exc:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="zone not found") from exc
    except NotAssignedToZoneError as exc:
        raise HTTPException(
            status_code=status.HTTP_403_FORBIDDEN, detail="not assigned to this zone"
        ) from exc
    response.status_code = status.HTTP_201_CREATED if created else status.HTTP_200_OK
    return visit
```

Note: the `status_code=status.HTTP_201_CREATED` that was previously on the `@router.post(...)` decorator itself is REMOVED — the decorator's `status_code` sets the default/documented status, but this endpoint now needs to set it dynamically per-request (201 vs 200), exactly matching how `pings/router.py`'s `submit_ping_endpoint` already does this (`response: Response` param + `response.status_code = ...` inside the function body). Look at that function for the exact precedent.

