# backend/app/tasks/router.py
import uuid

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth.deps import get_current_user, require_manager, require_rep
from app.auth.models import User
from app.db import get_db
from app.tasks.schemas import TaskCreate, TaskOut, TaskUpdate
from app.tasks.service import (
    TaskNotFoundError,
    TaskNotOpenError,
    cancel_task,
    complete_task,
    create_task,
    get_task,
    list_tasks,
    update_task,
)
from app.zones.service import RepNotFoundError

router = APIRouter(prefix="/api/v1/tasks", tags=["tasks"])


@router.post("", response_model=TaskOut, status_code=status.HTTP_201_CREATED)
async def create_task_endpoint(
    body: TaskCreate,
    current_user: User = Depends(require_manager),
    db: AsyncSession = Depends(get_db),
) -> TaskOut:
    try:
        return await create_task(
            db,
            tenant_id=current_user.tenant_id,
            assigned_to=body.assigned_to,
            title=body.title,
            due_date=body.due_date,
            priority=body.priority,
            external_reference=body.external_reference,
        )
    except RepNotFoundError as exc:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="rep not found") from exc


@router.get("", response_model=list[TaskOut])
async def list_tasks_endpoint(
    limit: int = Query(50, ge=1, le=200),
    offset: int = Query(0, ge=0),
    current_user: User = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
) -> list[TaskOut]:
    return await list_tasks(db, current_user, limit=limit, offset=offset)


@router.get("/{task_id}", response_model=TaskOut)
async def get_task_endpoint(
    task_id: uuid.UUID,
    current_user: User = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
) -> TaskOut:
    task = await get_task(db, current_user, task_id)
    if task is None:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="task not found")
    return task


@router.patch("/{task_id}", response_model=TaskOut)
async def update_task_endpoint(
    task_id: uuid.UUID,
    body: TaskUpdate,
    current_user: User = Depends(require_manager),
    db: AsyncSession = Depends(get_db),
) -> TaskOut:
    try:
        return await update_task(
            db,
            tenant_id=current_user.tenant_id,
            task_id=task_id,
            title=body.title,
            due_date=body.due_date,
            priority=body.priority,
        )
    except TaskNotFoundError as exc:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="task not found") from exc
    except TaskNotOpenError as exc:
        raise HTTPException(status_code=status.HTTP_409_CONFLICT, detail="task is not open") from exc


@router.post("/{task_id}/complete", response_model=TaskOut)
async def complete_task_endpoint(
    task_id: uuid.UUID,
    current_user: User = Depends(require_rep),
    db: AsyncSession = Depends(get_db),
) -> TaskOut:
    try:
        return await complete_task(
            db, tenant_id=current_user.tenant_id, rep_id=current_user.id, task_id=task_id
        )
    except TaskNotFoundError as exc:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="task not found") from exc
    except TaskNotOpenError as exc:
        raise HTTPException(status_code=status.HTTP_409_CONFLICT, detail="task is not open") from exc


@router.post("/{task_id}/cancel", response_model=TaskOut)
async def cancel_task_endpoint(
    task_id: uuid.UUID,
    current_user: User = Depends(require_manager),
    db: AsyncSession = Depends(get_db),
) -> TaskOut:
    try:
        return await cancel_task(db, tenant_id=current_user.tenant_id, task_id=task_id)
    except TaskNotFoundError as exc:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="task not found") from exc
    except TaskNotOpenError as exc:
        raise HTTPException(status_code=status.HTTP_409_CONFLICT, detail="task is not open") from exc
