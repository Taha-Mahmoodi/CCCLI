@router.post("/{goal_id}/log-value", response_model=GoalOut)
async def log_value_endpoint(
    goal_id: uuid.UUID,
    body: GoalLogValue,
    current_user: User = Depends(require_rep),
    db: AsyncSession = Depends(get_db),
) -> GoalOut:
    try:
        return await log_value(
            db, tenant_id=current_user.tenant_id, rep_id=current_user.id, goal_id=goal_id, value=body.value
        )
    except GoalNotFoundError as exc:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="goal not found") from exc
    except MetricNotManualError as exc:
