class GoalNotFoundError(Exception):
    pass


class MetricNotManualError(Exception):
    pass


async def log_value(
    db: AsyncSession, tenant_id: uuid.UUID, rep_id: uuid.UUID, goal_id: uuid.UUID, value: float
) -> Goal:
    result = await db.execute(select(Goal).where(Goal.id == goal_id, Goal.rep_id == rep_id))
    goal = result.scalar_one_or_none()
    if goal is None or goal.tenant_id != tenant_id:
        raise GoalNotFoundError(goal_id)

    if goal.metric_type != "SALES_VALUE":
        raise MetricNotManualError(goal_id)

    goal.manual_value = value
    await db.commit()
    await db.refresh(goal)
    return goal


def _period_bounds(period_start: date, period_end: date) -> tuple[datetime, datetime]:
    # Half-open range: [start of period_start, start of the day after period_end).
    # period_end's whole calendar day is included with no double-counting at midnight.
    start_dt = datetime.combine(period_start, time.min, tzinfo=timezone.utc)
    end_dt_exclusive = datetime.combine(period_end + timedelta(days=1), time.min, tzinfo=timezone.utc)
    return start_dt, end_dt_exclusive


async def _compute_achieved(db: AsyncSession, goal: Goal) -> float:
    if goal.metric_type == "SALES_VALUE":
        return goal.manual_value or 0.0

    start_dt, end_dt_exclusive = _period_bounds(goal.period_start, goal.period_end)

    if goal.metric_type == "VISIT_COUNT":
        result = await db.execute(
            select(func.count()).select_from(Visit).where(
                Visit.rep_id == goal.rep_id,
                Visit.checked_in_at >= start_dt,
                Visit.checked_in_at < end_dt_exclusive,
            )
        )
        return float(result.scalar_one())

    result = await db.execute(
        select(func.count()).select_from(Task).where(
            Task.assigned_to == goal.rep_id,
            Task.status == "COMPLETED",
            Task.completed_at >= start_dt,
            Task.completed_at < end_dt_exclusive,
        )
    )
    return float(result.scalar_one())


async def get_goal_progress(db: AsyncSession, current_user: User, goal_id: uuid.UUID) -> dict | None:
    goal = await get_goal(db, current_user, goal_id)
    if goal is None:
        return None

    achieved = await _compute_achieved(db, goal)
    return {
        "goal_id": goal.id,
        "rep_id": goal.rep_id,
        "metric_type": goal.metric_type,
        "target": goal.target,
        "achieved": achieved,
        "period_start": goal.period_start,
        "period_end": goal.period_end,
    }
```

Note on `log_value`'s tenant/ownership check: query filters by `id` AND `rep_id` together (a rep can only log their own goal's value — this is a rep-only endpoint, mirrors `complete_task`'s `Task.assigned_to == rep_id` shape), then an explicit `goal.tenant_id != tenant_id` post-fetch check for cross-tenant defense-in-depth, same pattern as every mutation in this codebase that fetches by id.

