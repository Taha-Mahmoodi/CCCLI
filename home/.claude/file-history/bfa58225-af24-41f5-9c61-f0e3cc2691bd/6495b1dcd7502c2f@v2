# backend/app/goals/service.py
import uuid
from datetime import date

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth.models import User
from app.goals.models import Goal
from app.zones.service import RepNotFoundError


async def create_goal(
    db: AsyncSession,
    tenant_id: uuid.UUID,
    rep_id: uuid.UUID,
    metric_type: str,
    target: float,
    period_start: date,
    period_end: date,
) -> Goal:
    rep_result = await db.execute(
        select(User).where(User.id == rep_id, User.role == "rep", User.tenant_id == tenant_id)
    )
    if rep_result.scalar_one_or_none() is None:
        raise RepNotFoundError(rep_id)

    goal = Goal(
        id=uuid.uuid4(),
        tenant_id=tenant_id,
        rep_id=rep_id,
        metric_type=metric_type,
        target=target,
        period_start=period_start,
        period_end=period_end,
    )
    db.add(goal)
    await db.commit()
    await db.refresh(goal)
    return goal


async def get_goal(db: AsyncSession, current_user: User, goal_id: uuid.UUID) -> Goal | None:
    query = select(Goal).where(Goal.id == goal_id)
    if current_user.role != "manager":
        query = query.where(Goal.rep_id == current_user.id)
    result = await db.execute(query)
    return result.scalar_one_or_none()


async def list_goals(
    db: AsyncSession, current_user: User, limit: int = 50, offset: int = 0
) -> list[Goal]:
    query = (
        select(Goal)
        .order_by(Goal.created_at.desc(), Goal.id.desc())
        .limit(limit)
        .offset(offset)
    )
    if current_user.role != "manager":
        query = query.where(Goal.rep_id == current_user.id)
    result = await db.execute(query)
    return list(result.scalars().all())
```

Note: `create_goal`'s rep-lookup query includes an explicit `User.tenant_id == tenant_id` clause, same defense-in-depth reasoning as `tasks.service.create_task` and `zones.service.assign_rep_to_zone` — the caller (a manager) has a trusted `tenant_id`, and the assignee must be proven to belong to that same tenant before a goal can reference them.

