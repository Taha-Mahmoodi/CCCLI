# backend/app/goals/router.py
import uuid

from fastapi import APIRouter, Depends, HTTPException, Query, status
from sqlalchemy.ext.asyncio import AsyncSession

from app.auth.deps import get_current_user, require_manager, require_rep
from app.auth.models import User
from app.db import get_db
from app.goals.schemas import GoalCreate, GoalLogValue, GoalOut, GoalProgress
from app.goals.service import (
    GoalNotFoundError,
    MetricNotManualError,
    create_goal,
    get_goal,
    get_goal_progress,
    list_goals,
    log_value,
)
from app.zones.service import RepNotFoundError

router = APIRouter(prefix="/api/v1/goals", tags=["goals"])


@router.post("", response_model=GoalOut, status_code=status.HTTP_201_CREATED)
async def create_goal_endpoint(
    body: GoalCreate,
    current_user: User = Depends(require_manager),
    db: AsyncSession = Depends(get_db),
) -> GoalOut:
    try:
        return await create_goal(
            db,
            tenant_id=current_user.tenant_id,
            rep_id=body.rep_id,
            metric_type=body.metric_type,
            target=body.target,
            period_start=body.period_start,
            period_end=body.period_end,
        )
    except RepNotFoundError as exc:
        raise HTTPException(status_code=status.HTTP_404_NOT_FOUND, detail="rep not found") from exc


@router.get("", response_model=list[GoalOut])
async def list_goals_endpoint(
    limit: int = Query(50, ge=1, le=200),
    offset: int = Query(0, ge=0),
    current_user: User = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
) -> list[GoalOut]:
    return await list_goals(db, current_user, limit=limit, offset=offset)


@router.get("/{goal_id}", response_model=GoalOut)
async def get_goal_endpoint(
    goal_id: uuid.UUID,
    current_user: User = Depends(get_current_user),
    db: AsyncSession = Depends(get_db),
) -> GoalOut:
    goal = await get_goal(db, current_user, goal_id)
