// tablet/src/location/TrackingToggle.tsx
import { useRef, useState } from 'react'
import { startWatching, stopWatching } from './backgroundLocation'
import { usePingPoster } from './usePingPoster'
import { submitPing } from '../api/pings'
import type { GeoLocation } from './backgroundLocation'

const PING_POST_INTERVAL_MS = 30_000

export function TrackingToggle() {
  const [isTracking, setIsTracking] = useState(false)
  const [lastPostedAt, setLastPostedAt] = useState<string | null>(null)
  const [error, setError] = useState<string | null>(null)
  const watcherIdRef = useRef<string | null>(null)
  const latestLocationRef = useRef<GeoLocation | null>(null)

  usePingPoster(
    () => (isTracking ? latestLocationRef.current : null),
    PING_POST_INTERVAL_MS,
    (location) => {
      submitPing({
        recorded_at: new Date(location.time ?? Date.now()).toISOString(),
        latitude: location.latitude,
        longitude: location.longitude,
        accuracy: location.accuracy,
        idempotency_key: crypto.randomUUID(),
      })
        .then(() => setLastPostedAt(new Date().toLocaleTimeString()))
        .catch((err) => setError(err instanceof Error ? err.message : 'Failed to send location'))
    },
  )

  async function handleToggle() {
    setError(null)
    if (isTracking) {
      if (watcherIdRef.current) await stopWatching(watcherIdRef.current)
      watcherIdRef.current = null
      setIsTracking(false)
      return
    }
    try {
      const id = await startWatching((location) => {
        latestLocationRef.current = location
      })
      watcherIdRef.current = id
      setIsTracking(true)
    } catch (err) {
      setError(err instanceof Error ? err.message : 'Failed to start location tracking')
    }
  }

  return (
    <div className="min-h-screen bg-gray-50 p-8">
      <h1 className="text-2xl font-semibold text-gray-900 mb-4">Atlas Field Force</h1>
      <button
        onClick={handleToggle}
        className={`px-4 py-2 rounded text-white ${isTracking ? 'bg-red-600' : 'bg-blue-600'}`}
      >
        {isTracking ? 'Stop tracking' : 'Start tracking'}
      </button>
      {lastPostedAt && <p className="mt-4 text-sm text-gray-600">Last location sent: {lastPostedAt}</p>}
      {error && <p className="mt-4 text-sm text-red-600">{error}</p>}
    </div>
  )
}
```

