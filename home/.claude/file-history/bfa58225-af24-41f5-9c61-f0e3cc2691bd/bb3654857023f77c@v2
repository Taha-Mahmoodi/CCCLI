// tablet/src/location/backgroundLocation.ts
import { registerPlugin } from '@capacitor/core'

export interface GeoLocation {
  latitude: number
  longitude: number
  accuracy: number
  time: number | null
}

interface WatcherOptions {
  backgroundMessage?: string
  backgroundTitle?: string
  requestPermissions?: boolean
  stale?: boolean
  distanceFilter?: number
}

interface BackgroundGeolocationPlugin {
  addWatcher(
    options: WatcherOptions,
    callback: (position?: GeoLocation, error?: Error) => void,
  ): Promise<string>
  removeWatcher(options: { id: string }): Promise<void>
  openSettings(): Promise<void>
}

const BackgroundGeolocation = registerPlugin<BackgroundGeolocationPlugin>('BackgroundGeolocation')

export async function startWatching(onLocation: (location: GeoLocation) => void): Promise<string> {
  return BackgroundGeolocation.addWatcher(
    {
      backgroundMessage: 'Atlas Field Force is tracking your location for field visits.',
      backgroundTitle: 'Atlas Field Force',
      requestPermissions: true,
      stale: false,
      distanceFilter: 0,
    },
    (position, error) => {
      if (error) {
        console.error('Background location error:', error)
        return
      }
      if (position) onLocation(position)
    },
  )
}

export async function stopWatching(watcherId: string): Promise<void> {
  await BackgroundGeolocation.removeWatcher({ id: watcherId })
}
```

This hand-rolls the plugin's own TypeScript interfaces (`WatcherOptions`, `GeoLocation`, `BackgroundGeolocationPlugin`) rather than importing them from `@capacitor-community/background-geolocation`'s own type exports, deliberately — its published `definitions.d.ts` exports `WatcherOptions`/`Location`/`BackgroundGeolocationPlugin` under those exact names, but `Location` collides with the DOM global `Location` type (the browser's `window.location` type), which causes confusing shadowing errors in a project that also uses the real DOM `Location` anywhere. Defining a locally-scoped `GeoLocation` alias sidesteps that collision entirely. The shapes above were copied from the installed package's real `definitions.d.ts` at plan-writing time (verified by installing the package and reading it directly, not guessed) — if `npm run typecheck` reports a mismatch against the actually-installed version, trust the installed `.d.ts` over this plan's copy and adjust minimally, don't fight it by suppressing the error.

