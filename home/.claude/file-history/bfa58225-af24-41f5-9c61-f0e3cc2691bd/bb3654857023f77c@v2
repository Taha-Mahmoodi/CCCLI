```ts
// tablet/src/location/usePingPoster.ts
import { useEffect, useRef } from 'react'
import type { GeoLocation } from './backgroundLocation'

export function usePingPoster(
  getLatestLocation: () => GeoLocation | null,
  intervalMs: number,
  onPost: (location: GeoLocation) => void,
): void {
  const getLatestLocationRef = useRef(getLatestLocation)
  getLatestLocationRef.current = getLatestLocation
  const onPostRef = useRef(onPost)
  onPostRef.current = onPost

  useEffect(() => {
    const id = setInterval(() => {
      const location = getLatestLocationRef.current()
      if (location) onPostRef.current(location)
    }, intervalMs)
    return () => clearInterval(id)
  }, [intervalMs])
}
```

