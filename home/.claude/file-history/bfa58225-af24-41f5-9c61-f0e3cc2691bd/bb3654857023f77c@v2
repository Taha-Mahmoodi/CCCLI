```ts
// tablet/src/auth/preferencesStore.ts
import { Preferences } from '@capacitor/preferences'

const REFRESH_TOKEN_KEY = 'atlas_refresh_token'

let currentAccessToken: string | null = null

export function setAccessToken(token: string | null): void {
  currentAccessToken = token
}

export function getAccessToken(): string | null {
  return currentAccessToken
}

export async function setRefreshToken(token: string | null): Promise<void> {
  if (token === null) {
    await Preferences.remove({ key: REFRESH_TOKEN_KEY })
  } else {
    await Preferences.set({ key: REFRESH_TOKEN_KEY, value: token })
  }
}

export async function getRefreshToken(): Promise<string | null> {
  const { value } = await Preferences.get({ key: REFRESH_TOKEN_KEY })
  return value
}

export async function setTokens(access: string | null, refresh: string | null): Promise<void> {
  setAccessToken(access)
  await setRefreshToken(refresh)
}
```

Note this is a real, load-bearing API difference from the dashboard's `tokenStore.ts`: `Preferences.get`/`.set`/`.remove` are all async (they cross the native bridge), unlike `localStorage`'s synchronous API. `setTokens` here is `async` where the dashboard's is not. Every caller in this app (in `AuthContext.tsx` and later in `client.ts`) must `await` it.

