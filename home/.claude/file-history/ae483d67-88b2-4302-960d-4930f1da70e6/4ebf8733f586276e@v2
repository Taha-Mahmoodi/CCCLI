/**
 * The v1 card deck (spec §4.1) — one memo per card, gesture-led.
 *
 * The accessibility floor, which is not optional: every gesture action is also a
 * visible labelled button AND a TalkBack custom action, each announced. The
 * custom actions matter most — TalkBack consumes left/right swipes for its own
 * navigation, so a blind user reaches like/skip through them, never a swipe.
 */
@Composable
fun CardDeckScreen(vm: RadioViewModel = viewModel()) {
  val view = LocalView.current
  val announce: (String) -> Unit = { message -> view.announceForAccessibility(message) }

  Column(
    Modifier.fillMaxSize().padding(20.dp),
    verticalArrangement = Arrangement.spacedBy(20.dp),
  ) {
    Text(
      "Your deck",
      style = MaterialTheme.typography.headlineSmall,
      modifier = Modifier.semantics { heading() },
    )

    when {
      vm.queue.isEmpty() -> EmptyDeck()
      vm.deckAtEnd -> EndOfDeck(onRestart = {
        vm.restartDeck()
        announce("Back to the top of your stream.")
      })
      else -> {
        Deck(vm, announce)
        ActionButtons(vm, announce)
      }
    }

    Spacer(Modifier.height(4.dp))
    RecordButton(vm, announce)
  }
}

@Composable
private fun EmptyDeck() {
  Column(
    Modifier.fillMaxWidth().padding(30.dp),
    horizontalAlignment = Alignment.CenterHorizontally,
    verticalArrangement = Arrangement.spacedBy(8.dp),
  ) {
    Text("Your deck is empty", style = MaterialTheme.typography.titleMedium)
    Text("Press and hold the record button to add the first memo.")
  }
}

@Composable
private fun EndOfDeck(onRestart: () -> Unit) {
  Column(
    Modifier.fillMaxWidth().padding(30.dp),
    horizontalAlignment = Alignment.CenterHorizontally,
    verticalArrangement = Arrangement.spacedBy(10.dp),
  ) {
    Text("You're all caught up", style = MaterialTheme.typography.titleMedium)
    Text("That's the end of the stream — no endless scroll here.")
    Button(onClick = onRestart, modifier = Modifier.heightIn(min = 48.dp)) { Text("Start over") }
  }
}

@Composable
private fun Deck(vm: RadioViewModel, announce: (String) -> Unit) {
  var offsetX by remember { mutableFloatStateOf(0f) }
  var offsetY by remember { mutableFloatStateOf(0f) }

  val current = vm.deckCurrent ?: return
  val next = vm.deckNext

  val afterAdvance: (String) -> Unit = { msg ->
    announce(if (vm.deckAtEnd) "You're all caught up. That's the end of the stream." else msg)
  }
  val likeIntent: () -> Unit = {
    if (vm.likeIntent()) afterAdvance("Liked. Next memo.") else announce("Liked.")
  }
  val likeAndNext: () -> Unit = { vm.likeAndNext(); afterAdvance("Liked. Next memo.") }
  val skip: () -> Unit = { vm.skipCard(); afterAdvance("Skipped.") }

  Box(Modifier.fillMaxWidth()) {
    // The next card peeking behind, for depth — decorative, hidden from TalkBack.
    if (next != null) {
      Box(
        Modifier
          .graphicsLayer { scaleX = 0.95f; scaleY = 0.95f; alpha = 0.5f }
          .clearAndSetSemantics {},
      ) { MemoCardFace(next, vm.deckCursor + 1, showTranscript = false, onPlay = {}) }
    }

    Box(
      Modifier
        .offset { IntOffset(offsetX.roundToInt(), 0) }
        .graphicsLayer { rotationZ = offsetX * 0.04f }
        .pointerInput(vm.deckCursor) {
          detectDragGestures(
            onDragEnd = {
              val action = classifySwipe(offsetX, offsetY)
              offsetX = 0f
              offsetY = 0f
              when (action) {
                SwipeAction.SKIP -> skip()
                SwipeAction.LIKE -> likeIntent()
                null -> Unit
              }
            },
            onDragCancel = { offsetX = 0f; offsetY = 0f },
          ) { change, dragAmount ->
            change.consume()
            offsetX += dragAmount.x
            offsetY += dragAmount.y
          }
        }
        // The screen-reader route: custom actions, not swipes.
        .semantics {
          contentDescription =
            "Memo ${vm.deckCursor + 1} of ${vm.queue.size}, ${formatDuration(current.durationMs)}"
          customActions = listOf(
            CustomAccessibilityAction(if (current.liked) "Unlike" else "Like") {
              vm.toggleLikeCurrent(); true
            },
            CustomAccessibilityAction("Like and go to the next memo") { likeAndNext(); true },
            CustomAccessibilityAction("Skip this memo") { skip(); true },
            CustomAccessibilityAction("Play") { vm.playFrom(vm.deckCursor); true },
          )
        },
    ) {
      MemoCardFace(current, vm.deckCursor, showTranscript = true) { vm.playFrom(vm.deckCursor) }
    }
  }
}

@Composable
private fun MemoCardFace(memo: Memo, index: Int, showTranscript: Boolean, onPlay: () -> Unit) {
  Column(
    Modifier
      .fillMaxWidth()
      .heightIn(min = 280.dp)
      .clip(RoundedCornerShape(24.dp))
      .background(MaterialTheme.colorScheme.surfaceVariant)
      .padding(20.dp),
    verticalArrangement = Arrangement.spacedBy(14.dp),
  ) {
    Row(Modifier.fillMaxWidth(), horizontalArrangement = Arrangement.SpaceBetween) {
      Column {
        Text("Memo ${index + 1}", style = MaterialTheme.typography.bodyMedium)
        Text(formatDuration(memo.durationMs), style = MaterialTheme.typography.titleMedium)
      }
      if (memo.liked) {
        Icon(Icons.Filled.Favorite, contentDescription = "You liked this memo")
      }
    }

    Box(Modifier.fillMaxWidth(), contentAlignment = Alignment.Center) {
      FilledIconButton(
        onClick = onPlay,
        modifier = Modifier.size(72.dp).semantics {
          contentDescription = "Play memo ${index + 1}"
        },
      ) { Icon(Icons.Filled.PlayArrow, contentDescription = null) }
    }

    if (showTranscript) {
      val transcript = memo.displayTranscript
      if (transcript.isEmpty()) {
        Text("Voice memo — press play to listen.", style = MaterialTheme.typography.bodySmall)
      } else {
        Text(transcript)
        if (memo.correctedTranscript == null) {
          Text(
            "(machine transcript — may contain errors)",
            style = MaterialTheme.typography.bodySmall,
          )
        }
      }
    }
  }
}

/** The non-gesture floor: a labelled button for every gesture action. */
@Composable
private fun ActionButtons(vm: RadioViewModel, announce: (String) -> Unit) {
  val afterAdvance: (String) -> Unit = { msg ->
    announce(if (vm.deckAtEnd) "You're all caught up." else msg)
  }

  Row(
    Modifier.fillMaxWidth(),
    horizontalArrangement = Arrangement.spacedBy(16.dp, Alignment.CenterHorizontally),
    verticalAlignment = Alignment.CenterVertically,
  ) {
    OutlinedButton(
      onClick = { vm.skipCard(); afterAdvance("Skipped.") },
      modifier = Modifier.size(56.dp).semantics { contentDescription = "Skip this memo" },
    ) { Icon(Icons.Filled.ThumbDown, contentDescription = null) }

    val liked = vm.deckCurrent?.liked == true
    FilledIconButton(
      onClick = { vm.toggleLikeCurrent(); announce(if (liked) "Unliked." else "Liked.") },
      modifier = Modifier.size(64.dp).semantics {
        contentDescription = if (liked) "Unlike this memo" else "Like this memo"
      },
    ) {
      Icon(
        if (liked) Icons.Filled.Favorite else Icons.Filled.FavoriteBorder,
        contentDescription = null,
      )
    }

    OutlinedButton(
      onClick = { vm.likeAndNext(); afterAdvance("Liked. Next memo.") },
      modifier = Modifier.size(56.dp).semantics {
        contentDescription = "Like and go to the next memo"
      },
    ) { Icon(Icons.Filled.SkipNext, contentDescription = null) }
  }
}

/**
 * Press-and-hold to record (the v1 gesture) with the mandatory tap twin: a
 * sustained press records while held and stops on release; a quick tap toggles
 * instead, so a user with nerve damage who cannot hold is never excluded.
 *
 * Deliberately a Box, not a Button: a Button's own clickable would compete with
 * `pointerInput` for the press stream. TalkBack still activates it through the
 * `onClick` semantics action below — it never has to perform a raw long-press.
 */
@Composable
private fun RecordButton(vm: RadioViewModel, announce: (String) -> Unit) {
  val toggle: () -> Unit = {
    if (vm.isRecording) {
      vm.stopRecording()
      announce("Memo saved.")
    } else {
      vm.startRecording()
      announce("Recording started. Activate again to stop.")
    }
  }

  Box(Modifier.fillMaxWidth(), contentAlignment = Alignment.Center) {
    Box(
      Modifier
        .size(80.dp)
        .clip(CircleShape)
        .background(
          if (vm.isRecording) MaterialTheme.colorScheme.error
          else MaterialTheme.colorScheme.primary,
        )
        .semantics(mergeDescendants = true) {
          role = Role.Button
          contentDescription =
            if (vm.isRecording) "Stop recording"
            else "Record a voice memo. Tap, or press and hold."
          onClick(label = "Toggle recording") { toggle(); true }
        }
        .pointerInput(vm.isRecording) {
          detectTapGestures(
            onPress = {
              if (vm.isRecording) {
                vm.stopRecording() // tap-toggle stop
                announce("Memo saved.")
                tryAwaitRelease()
              } else {
                val startedAt = System.currentTimeMillis()
                vm.startRecording()
                announce("Recording — release to stop, or tap again.")
                tryAwaitRelease()
                // Held past the threshold → it was a press-and-hold, so stop on
                // release. A quick tap leaves recording on (the toggle twin).
                if (System.currentTimeMillis() - startedAt >= HOLD_TO_RECORD_MS) {
                  vm.stopRecording()
                  announce("Memo saved.")
                }
              }
            },
          )
        },
      contentAlignment = Alignment.Center,
    ) {
      Icon(
        if (vm.isRecording) Icons.Filled.Stop else Icons.Filled.Mic,
        contentDescription = null,
        tint = if (vm.isRecording) MaterialTheme.colorScheme.onError
        else MaterialTheme.colorScheme.onPrimary,
      )
    }
  }
}
