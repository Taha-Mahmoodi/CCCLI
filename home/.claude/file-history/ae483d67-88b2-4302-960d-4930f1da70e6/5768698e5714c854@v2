import { describe, it, expect } from "vitest";
import {
  classifySwipe,
  isDoubleActivation,
  SWIPE_THRESHOLD_PX,
  DOUBLE_ACTIVATION_MS,
} from "@/lib/gestures";

describe("classifySwipe", () => {
  it("right past threshold is a like", () => {
    expect(classifySwipe(120, 10)).toBe("like");
  });
  it("left past threshold is a skip", () => {
    expect(classifySwipe(-120, -10)).toBe("skip");
  });
  it("short drags are not a decision", () => {
    expect(classifySwipe(50, 0)).toBeNull();
    expect(classifySwipe(-SWIPE_THRESHOLD_PX + 1, 0)).toBeNull();
  });
  it("mostly-vertical drags are left for scrolling", () => {
    expect(classifySwipe(120, 200)).toBeNull();
    expect(classifySwipe(-120, -130)).toBeNull();
  });
  it("is decisive right at the threshold when clearly horizontal", () => {
    expect(classifySwipe(SWIPE_THRESHOLD_PX, 0)).toBe("like");
    expect(classifySwipe(-SWIPE_THRESHOLD_PX, 5)).toBe("skip");
  });
});

describe("isDoubleActivation", () => {
  it("is false with no previous activation", () => {
    expect(isDoubleActivation(null, 100)).toBe(false);
  });
  it("is true for a second activation within the window", () => {
    expect(isDoubleActivation(100, 100 + DOUBLE_ACTIVATION_MS)).toBe(true);
    expect(isDoubleActivation(100, 300)).toBe(true);
    expect(isDoubleActivation(100, 100)).toBe(true); // same instant
  });
  it("is false once the window has passed", () => {
    expect(isDoubleActivation(100, 100 + DOUBLE_ACTIVATION_MS + 1)).toBe(false);
  });
  it("is false for a non-monotonic clock (now before prev)", () => {
    expect(isDoubleActivation(500, 100)).toBe(false);
  });
});
