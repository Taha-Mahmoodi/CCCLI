// Token-bucket rate limiter, per key (IP). Stricter buckets for new accounts
// come with auth (Slice 2). In-memory is fine at beta scale.
// ponytail: in-memory Map; move to Redis if the API runs multi-instance.

interface Bucket {
  tokens: number;
  last: number;
}

export interface RateLimiter {
  allow(key: string): boolean;
}

export function createRateLimiter(opts: { capacity: number; refillPerSec: number }): RateLimiter {
  const buckets = new Map<string, Bucket>();
  return {
    allow(key) {
      const now = Date.now();
      const b = buckets.get(key) ?? { tokens: opts.capacity, last: now };
      const elapsed = (now - b.last) / 1000;
      b.tokens = Math.min(opts.capacity, b.tokens + elapsed * opts.refillPerSec);
      b.last = now;
      if (b.tokens < 1) {
        buckets.set(key, b);
        return false;
      }
      b.tokens -= 1;
      buckets.set(key, b);
      return true;
    },
  };
}
