name: CI

on:
  pull_request:
    branches: [dev, prod]
  push:
    branches: [prod]

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  sandbox:
    name: sandbox (typecheck · lint · test · build)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 26
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm typecheck
      - run: pnpm lint
      - run: pnpm test
      - run: pnpm build

  a11y:
    name: a11y + visual (axe / playwright)
    runs-on: ubuntu-latest
    needs: sandbox
    steps:
      - uses: actions/checkout@v4
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 26
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm --filter web build
      - run: pnpm --filter web exec playwright install --with-deps chromium
      - run: pnpm --filter web e2e

  ios:
    name: iOS (swift build + logic)
    runs-on: macos-latest
    steps:
      - uses: actions/checkout@v4
      - name: Compile SwiftUI screens + verify engine
        working-directory: apps/ios
        run: |
          swift build          # compiles ThirdEyeCore + ThirdEyeUI (SwiftUI + a11y)
          swift run ThirdEyeCoreChecks

  e2ee-dm:
    name: E2EE DM (libsignal)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 26
      - name: Verify real libsignal E2EE
        working-directory: packages/dm
        run: |
          npm install
          npm run verify

  android-core:
    name: Android core (kotlin)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "21"
      - name: Install Kotlin compiler
        run: |
          curl -sL -o kotlinc.zip https://github.com/JetBrains/kotlin/releases/download/v2.1.0/kotlin-compiler-2.1.0.zip
          unzip -q kotlinc.zip -d "$HOME/kt"
          echo "$HOME/kt/kotlinc/bin" >> "$GITHUB_PATH"
      - name: Compile SwiftUI-equivalent engine + verify
        working-directory: apps/android/core
        run: |
          kotlinc src/main/kotlin -include-runtime -d core.jar
          java -jar core.jar

  android-app:
    name: Android app (compose)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - uses: android-actions/setup-android@v3
      - uses: gradle/actions/setup-gradle@v4
      - name: Build the Jetpack Compose app (APK)
        working-directory: apps/android
        # assembleDebug — not just compileKotlin — so manifest merge, resource
        # linking (themes/@style, PlaybackService foregroundServiceType, perms),
        # dexing and APK packaging are all exercised. Debug uses an auto keystore
        # (no signing, no emulator). This is the honest "app builds" gate.
        run: gradle :app:assembleDebug --no-daemon --stacktrace
