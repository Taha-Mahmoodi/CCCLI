import Foundation

// Pure gesture rules for the v1 card deck — the Swift twin of the web's
// `lib/gestures.ts`, so every platform decides identically.
//
// v1 reverses spec principles 5 & 6 (recorded with its dissent in spec §4.1):
// the deck is gesture-led. This file is only the CLASSIFIER. Every action it
// names is ALSO wired, in the UI, to a visible labelled button and to a
// VoiceOver custom action — because VoiceOver consumes left/right swipes for
// its own navigation before the app ever sees them, so for a screen-reader user
// the rotor action, not the swipe, is the route that actually works.

public enum SwipeAction: String, Sendable {
  case like
  case skip
}

/// A horizontal drag past this many points is a decision. Shorter drags, or
/// drags more vertical than horizontal, are not — so hesitation or a vertical
/// scroll never fires like/skip by accident.
public let swipeThresholdPoints: Double = 96

public func classifySwipe(
  dx: Double,
  dy: Double,
  threshold: Double = swipeThresholdPoints,
) -> SwipeAction? {
  if abs(dx) < threshold { return nil }
  if abs(dx) <= abs(dy) { return nil }
  return dx > 0 ? .like : .skip
}

/// "Swipe right twice fast" → like AND advance. Seconds here (the web twin uses
/// milliseconds); same semantic. A non-timed route to the same result always
/// exists — the "Like & next" button and rotor action — so nobody is gated on
/// hitting a time window, which is principle 6's real constraint.
public let doubleActivationSeconds: Double = 0.4

public func isDoubleActivation(
  previous: Double?,
  now: Double,
  window: Double = doubleActivationSeconds,
) -> Bool {
  guard let previous else { return false }
  let gap = now - previous
  return gap >= 0 && gap <= window
}
