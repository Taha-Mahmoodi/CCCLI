import { describe, it, expect } from "vitest";
import { memoMatchesQuery, filterMemos } from "@/lib/search";
import type { Memo } from "@/lib/types";

const m = (over: Partial<Memo>): Memo => ({
  id: "x",
  createdAt: 0,
  durationMs: 1000,
  mime: "audio/webm",
  liked: false,
  channelId: "main",
  machineTranscript: "",
  ...over,
});

describe("memoMatchesQuery", () => {
  it("empty query matches everything", () => {
    expect(memoMatchesQuery(m({}), 0, "")).toBe(true);
  });
  it("matches the machine transcript, case-insensitive", () => {
    expect(memoMatchesQuery(m({ machineTranscript: "Hello World" }), 0, "hello")).toBe(true);
    expect(memoMatchesQuery(m({ machineTranscript: "Hello" }), 0, "xyz")).toBe(false);
  });
  it("searches the correction once one exists (what the user sees)", () => {
    const memo = m({ machineTranscript: "wrong", correctedTranscript: "right answer" });
    expect(memoMatchesQuery(memo, 0, "right")).toBe(true);
    expect(memoMatchesQuery(memo, 0, "wrong")).toBe(false);
  });
  it("matches the memo N label", () => {
    expect(memoMatchesQuery(m({}), 2, "memo 3")).toBe(true);
  });
});

describe("filterMemos", () => {
  it("keeps original stream indices so playback targets the right memo", () => {
    const memos = [
      m({ machineTranscript: "apple" }),
      m({ machineTranscript: "banana" }),
      m({ machineTranscript: "cherry" }),
    ];
    const r = filterMemos(memos, "banana");
    expect(r).toHaveLength(1);
    expect(r[0].index).toBe(1);
  });
  it("empty query returns all with indices", () => {
    expect(filterMemos([m({}), m({})], "").map((x) => x.index)).toEqual([0, 1]);
  });
});
