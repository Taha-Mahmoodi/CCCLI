// Pick a MediaRecorder mime type the current browser can actually WRITE.
// Chromium writes webm/opus; Safari only writes mp4/aac and cannot write webm.
// Order matters — best quality/size first.

const CANDIDATES = [
  "audio/webm;codecs=opus",
  "audio/webm",
  "audio/mp4",
  "audio/wav",
] as const;

type IsSupported = (type: string) => boolean;

const defaultIsSupported: IsSupported = (type) =>
  typeof MediaRecorder !== "undefined" &&
  typeof MediaRecorder.isTypeSupported === "function" &&
  MediaRecorder.isTypeSupported(type);

/**
 * Returns the first mime the browser can write, or "" to let the browser
 * choose its own default (never throw — recording must not be blocked here).
 */
export function pickMimeType(isSupported: IsSupported = defaultIsSupported): string {
  for (const type of CANDIDATES) {
    try {
      if (isSupported(type)) return type;
    } catch {
      // isTypeSupported can throw on some engines — treat as unsupported.
    }
  }
  return "";
}

export const MIME_CANDIDATES = CANDIDATES;
