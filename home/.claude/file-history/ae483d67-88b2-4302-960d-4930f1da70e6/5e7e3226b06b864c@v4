package com.thirdeyeworld.android

import android.app.Application
import androidx.compose.runtime.getValue
import androidx.compose.runtime.mutableStateOf
import androidx.compose.runtime.setValue
import androidx.lifecycle.AndroidViewModel
import com.thirdeyeworld.core.ALL_CHANNELS
import com.thirdeyeworld.core.Channel
import com.thirdeyeworld.core.Memo
import com.thirdeyeworld.core.PlayerStatus
import com.thirdeyeworld.core.RadioEngine
import com.thirdeyeworld.core.isDoubleActivation

/**
 * Drives the Compose UI off the verified [RadioEngine] (identical logic to web
 * + iOS). The engine is a mutable class, so after each action we mirror its
 * state into Compose [androidx.compose.runtime.State] to trigger recomposition.
 * Audio capture/playback goes through [AudioService]; the Media3 session for the
 * lock-screen / headphone transport route lives in [PlaybackService].
 */
class RadioViewModel(app: Application) : AndroidViewModel(app) {
  private val engine = RadioEngine()
  private val audio: AudioService = AndroidAudioService(app)

  /** memo id -> file path on disk, so a card can replay its own audio. */
  private val audioPaths = mutableMapOf<String, String>()

  var queue by mutableStateOf<List<Memo>>(emptyList()); private set
  var channels by mutableStateOf<List<Channel>>(engine.channels); private set
  var activeChannel by mutableStateOf(engine.activeChannel); private set
  var currentIndex by mutableStateOf(0); private set
  var status by mutableStateOf(PlayerStatus.IDLE); private set
  var isPlaying by mutableStateOf(false); private set
  var playbackRate by mutableStateOf(1.0); private set
  var isRecording by mutableStateOf(false); private set

  private fun sync() {
    queue = engine.queue
    channels = engine.channels
    activeChannel = engine.activeChannel
    currentIndex = engine.currentIndex
    status = engine.status
    isPlaying = engine.isPlaying
    playbackRate = engine.playbackRate
  }

  fun startRecording() {
    // A denied mic permission throws here; stay honest about not recording.
    val started = runCatching { audio.startRecording() }.isSuccess
    isRecording = started
  }

  fun stopRecording() {
    if (!isRecording) return
    isRecording = false
    // No audio captured (too short, or permission denied) → no memo. A silent
    // 0-length card would be worse than nothing on a voice-first product.
    val recorded = runCatching { audio.stopRecording() }.getOrNull() ?: return
    val memo = Memo(
      id = java.util.UUID.randomUUID().toString(),
      createdAt = System.currentTimeMillis(),
      durationMs = recorded.durationMs,
      mime = "audio/m4a",
      channelId = if (activeChannel == ALL_CHANNELS) "main" else activeChannel,
    )
    audioPaths[memo.id] = recorded.path
    engine.addMemo(memo)
    sync()
  }

  /** Push the engine's current memo at the speakers, if we have its audio. */
  private fun playCurrent() {
    if (!engine.isPlaying) return
    val id = engine.queue.getOrNull(engine.currentIndex)?.id ?: return
    val path = audioPaths[id] ?: return
    audio.play(path, engine.playbackRate)
  }

  fun play() { engine.play(); sync(); playCurrent() }
  fun pause() { engine.pause(); audio.pause(); sync() }
  fun togglePlay() { if (engine.isPlaying) pause() else play() }
  fun next() { engine.next(); sync(); playCurrent() }
  fun previous() { engine.previous(); sync(); playCurrent() }
  fun playFrom(i: Int) { engine.playFrom(i); sync(); playCurrent() }
  fun toggleLike(id: String) { engine.toggleLike(id); sync() }
  fun selectChannel(id: String) { engine.setActiveChannel(id); sync(); restartDeck() }
  fun createChannel(name: String) { engine.createChannel(name); sync() }
  fun cyclePlaybackRate() { engine.cyclePlaybackRate(); audio.setRate(engine.playbackRate); sync() }

  override fun onCleared() {
    audio.release() // never leave the mic or player held
    super.onCleared()
  }

  fun stationName(id: String): String =
    if (id == ALL_CHANNELS) "All" else channels.firstOrNull { it.id == id }?.name ?: id

  // ---- v1 card deck ----
  //
  // Every action below is reachable three ways in the UI: the gesture, a
  // labelled button, and a TalkBack custom action. The custom action is the one
  // that actually reaches a blind user, since TalkBack eats raw swipes.

  var deckCursor by mutableStateOf(0); private set
  private var lastLikeAt: Long? = null

  val deckCurrent: Memo? get() = queue.getOrNull(deckCursor)
  val deckNext: Memo? get() = queue.getOrNull(deckCursor + 1)
  val deckAtEnd: Boolean get() = deckCursor >= queue.size

  private fun likeCurrentIfNeeded() {
    val c = deckCurrent ?: return
    if (!c.liked) { engine.toggleLike(c.id); sync() }
  }

  /** Swipe-right: like the card. A second like inside the window is the "twice
   *  fast" double → like AND advance. Returns true if it advanced. */
  fun likeIntent(): Boolean {
    deckCurrent ?: return false
    likeCurrentIfNeeded()
    val now = System.currentTimeMillis()
    if (isDoubleActivation(lastLikeAt, now)) {
      lastLikeAt = null
      deckCursor += 1
      return true
    }
    lastLikeAt = now
    return false
  }

  /** The non-timed twin of the double-swipe. */
  fun likeAndNext() {
    deckCurrent ?: return
    likeCurrentIfNeeded()
    lastLikeAt = null
    deckCursor += 1
  }

  fun skipCard() {
    deckCurrent ?: return
    lastLikeAt = null
    deckCursor += 1
  }

  /** The precise route — unlike is possible here; swipe only ever likes. */
  fun toggleLikeCurrent() {
    val c = deckCurrent ?: return
    engine.toggleLike(c.id)
    sync()
  }

  fun restartDeck() {
    deckCursor = 0
    lastLikeAt = null
  }
}
