// Shared Web Speech API (SpeechRecognition) plumbing — used by voice commands
// and by record-time transcription. Best-effort and fully isolated: its failure
// must never break recording or playback.

export interface RecognitionResult {
  0: { transcript: string };
  isFinal: boolean;
}
export interface RecognitionEvent {
  results: ArrayLike<RecognitionResult>;
  resultIndex: number;
}
export interface Recognition {
  continuous: boolean;
  interimResults: boolean;
  lang: string;
  start(): void;
  stop(): void;
  abort(): void;
  onresult: ((e: RecognitionEvent) => void) | null;
  onerror: ((e: { error: string }) => void) | null;
  onend: (() => void) | null;
}
type RecognitionCtor = new () => Recognition;

export function getRecognitionCtor(): RecognitionCtor | null {
  if (typeof window === "undefined") return null;
  const w = window as unknown as {
    SpeechRecognition?: RecognitionCtor;
    webkitSpeechRecognition?: RecognitionCtor;
  };
  return w.SpeechRecognition ?? w.webkitSpeechRecognition ?? null;
}

export function speechSupported(): boolean {
  return getRecognitionCtor() !== null;
}

/**
 * A live transcriber that runs alongside MediaRecorder. Accumulates final
 * results into a transcript string. Returns a handle to stop and read the text.
 * If SpeechRecognition is unavailable, everything is a no-op returning "".
 */
export function startTranscription(lang?: string): { stop: () => string } {
  const Ctor = getRecognitionCtor();
  if (!Ctor) return { stop: () => "" };

  let text = "";
  let stopped = false;
  const rec = new Ctor();
  rec.continuous = true;
  rec.interimResults = false;
  rec.lang = lang || (typeof navigator !== "undefined" ? navigator.language || "en-US" : "en-US");
  rec.onresult = (e) => {
    for (let i = e.resultIndex; i < e.results.length; i++) {
      const r = e.results[i];
      if (r.isFinal) text += (text ? " " : "") + r[0].transcript.trim();
    }
  };
  rec.onend = () => {
    // keep listening until we explicitly stop (some engines auto-end)
    if (!stopped) {
      try {
        rec.start();
      } catch {
        /* already running */
      }
    }
  };
  rec.onerror = () => {
    /* best-effort: ignore, transcript stays as-is */
  };
  try {
    rec.start();
  } catch {
    /* ignore */
  }

  return {
    stop: () => {
      stopped = true;
      try {
        rec.stop();
      } catch {
        /* ignore */
      }
      return text.trim();
    },
  };
}
