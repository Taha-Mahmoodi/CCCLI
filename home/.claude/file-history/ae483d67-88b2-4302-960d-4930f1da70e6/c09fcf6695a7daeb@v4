packages:
  - apps/*
  - services/*
  - packages/*
  # @tew/dm is a standalone npm package (libsignal's 54MB native tarball can't
  # be pnpm-fetched over a slow link); installed + CI-verified on its own.
  - "!packages/dm"

# Build scripts we explicitly trust (pnpm blocks all by default).
# sharp: next/image optimization. unrs-resolver: eslint import resolution.
allowBuilds:
  esbuild: true
  sharp: true
  unrs-resolver: true
