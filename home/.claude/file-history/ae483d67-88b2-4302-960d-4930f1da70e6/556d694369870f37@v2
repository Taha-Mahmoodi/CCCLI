import { describe, it, expect } from "vitest";
import { formatDuration, spokenDuration } from "@/lib/format";

describe("formatDuration", () => {
  it("formats as m:ss", () => {
    expect(formatDuration(7000)).toBe("0:07");
    expect(formatDuration(92000)).toBe("1:32");
  });
  it("clamps negatives to 0:00", () => {
    expect(formatDuration(-5)).toBe("0:00");
  });
});

describe("spokenDuration", () => {
  it("speaks seconds", () => {
    expect(spokenDuration(7000)).toBe("7 seconds");
    expect(spokenDuration(1000)).toBe("1 second");
  });
  it("speaks minutes and seconds", () => {
    expect(spokenDuration(92000)).toBe("1 minute 32 seconds");
  });
});
