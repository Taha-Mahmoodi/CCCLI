import * as React from "react";

export interface AvatarProps {
  /** Person's name; the first initial is shown. */
  name: string;
  /** Warm-palette background color (hex). */
  color: string;
  size?: number;
  /** Draws the "available now" ring + dot. Decorative — pair with a text label. */
  available?: boolean;
}

/**
 * Illustrative avatar: a warm-color rounded-square tile with the first
 * initial in the display serif. Decorative (aria-hidden) — the name is always
 * shown as adjacent text, so the avatar adds no information for screen-reader
 * users (design system: no pity imagery, no stock photos). v2: squircle
 * silhouette; optional availability ring (never the sole signal — SPEC §10).
 */
export function Avatar({ name, color, size = 56, available }: AvatarProps) {
  return (
    <span aria-hidden="true" className="relative inline-block flex-none">
      <span
        className={[
          "grid place-items-center font-display font-extrabold text-surface",
          available ? "ring-2 ring-success ring-offset-2 ring-offset-surface" : "",
        ]
          .filter(Boolean)
          .join(" ")}
        style={{
          width: size,
          height: size,
          background: color,
          borderRadius: Math.round(size * 0.28),
          fontSize: Math.round(size * 0.42),
        }}
      >
        {name.trim().charAt(0).toUpperCase()}
      </span>
      {available ? (
        <span
          className="absolute -bottom-0.5 -right-0.5 block rounded-pill bg-success ring-2 ring-surface"
          style={{ width: Math.max(10, size * 0.2), height: Math.max(10, size * 0.2) }}
        />
      ) : null}
    </span>
  );
}
