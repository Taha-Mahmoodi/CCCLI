/* ── VOLUNTEERS ────────────────── */
.vol-split { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
.role-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 24px; }
.role-card { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 22px; transition: box-shadow .2s, transform .2s; box-shadow: var(--shadow-sm); cursor: pointer; }
.role-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); border-color: var(--brand); }
.role-card .role-icon { width: 40px; height: 40px; border-radius: var(--radius-md); background: var(--brand-subtle); color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 19px; margin-bottom: 12px; }
.role-card h4 { font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--fg); margin-bottom: 6px; }
.role-card p { font-size: .85rem; color: var(--fg-muted); line-height: 1.5; margin-bottom: 10px; }
.role-tags { display: flex; gap: 6px; flex-wrap: wrap; }
.role-tag { font-family: var(--font-display); font-size: .66rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--fg-muted); background: var(--bg-subtle); padding: 3px 8px; border-radius: var(--radius-full); }

.vol-steps { display: flex; flex-direction: column; gap: 0; counter-reset: vstep; }
.vol-step { display: grid; grid-template-columns: 44px 1fr; gap: 18px; padding: 18px 0; border-bottom: 1px solid var(--border); counter-increment: vstep; position: relative; }
.vol-step:last-child { border-bottom: none; }
.vol-step::before { content: counter(vstep, decimal-leading-zero); font-family: var(--font-display); font-size: 1.1rem; font-weight: 700; color: var(--brand); width: 44px; height: 44px; border-radius: 50%; background: var(--brand-subtle); display: flex; align-items: center; justify-content: center; letter-spacing: .02em; }
.vol-step h4 { font-family: var(--font-display); font-size: 1.05rem; font-weight: 700; color: var(--fg); margin-bottom: 4px; letter-spacing: -.01em; }
.vol-step p { font-size: .92rem; color: var(--fg-muted); line-height: 1.55; }

.vol-form { background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-xl); padding: 32px; box-shadow: var(--shadow-md); }
.vol-form h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; color: var(--fg); margin-bottom: 20px; }
.checkbox-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
.cb-pill { display: flex; align-items: center; gap: 8px; padding: 9px 12px; background: var(--bg); border: 1.5px solid var(--border); border-radius: var(--radius-md); cursor: pointer; font-family: var(--font-display); font-size: .82rem; font-weight: 500; color: var(--fg); transition: all .15s; }
.cb-pill input { width: 14px; height: 14px; accent-color: var(--brand); }
.cb-pill:has(input:checked) { border-color: var(--brand); background: var(--brand-subtle); color: var(--brand); }

/* ── VALUES/PILLARS ─────────────── */
.pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--bg-elevated); }
.pillar { padding: 36px 32px; border-right: 1px solid var(--border); }
.pillar:last-child { border-right: none; }
.pillar .num-badge { font-family: var(--font-display); font-size: .72rem; font-weight: 700; letter-spacing: .1em; color: var(--brand); margin-bottom: 16px; }
.pillar h3 { font-family: var(--font-display); font-size: 1.2rem; font-weight: 700; color: var(--fg); margin-bottom: 12px; letter-spacing: -.01em; }
.pillar p { font-size: .92rem; color: var(--fg-muted); line-height: 1.6; }

/* ── QUOTE CTA BAND ─────────── */
.cta-band { padding: 80px var(--space-8); background: var(--brand); color: #fff; text-align: center; position: relative; overflow: hidden; }
.cta-band::before { content: ''; position: absolute; top: -30%; right: -10%; width: 400px; height: 400px; border-radius: 50%; background: rgba(255,255,255,.08); }
.cta-band::after { content: ''; position: absolute; bottom: -40%; left: -10%; width: 500px; height: 500px; border-radius: 50%; background: rgba(255,255,255,.05); }
.cta-inner { position: relative; max-width: 780px; margin: 0 auto; z-index: 1; }
.cta-inner h2 { font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.5rem); font-weight: 700; margin-bottom: 14px; letter-spacing: -.025em; line-height: 1.15; color: #fff; text-wrap: balance; }
.cta-inner p { font-size: 1.1rem; opacity: .9; margin-bottom: 28px; max-width: 600px; margin-left: auto; margin-right: auto; line-height: 1.6; }
.cta-band .btn-accent { padding: 15px 32px; font-size: 1.05rem; }
.cta-band .btn-secondary { color: #fff; border-color: rgba(255,255,255,.4); }
.cta-band .btn-secondary:hover { background: rgba(255,255,255,.1); color: #fff; border-color: #fff; }

