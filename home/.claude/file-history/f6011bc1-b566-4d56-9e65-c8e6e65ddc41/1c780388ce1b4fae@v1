import * as React from "react";

/**
 * Static, non-interactive label (e.g. a listener's topic). For a toggleable
 * version use <Chip>.
 */
export function Tag({ children }: { children: React.ReactNode }) {
  return (
    <span className="inline-flex items-center rounded-pill border border-border bg-surface-sunk px-3 py-1 text-sm font-semibold text-ink-soft">
      {children}
    </span>
  );
}
