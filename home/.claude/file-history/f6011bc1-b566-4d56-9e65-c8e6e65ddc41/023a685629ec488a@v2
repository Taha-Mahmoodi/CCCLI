/* ── FOOTER ──────────────────── */
/* Deepest night in every theme; a single gold hairline separates it from
   the page. Light theme keeps its ink-inverse footer (same tokens). */
footer { background: var(--bg-inverse); color: var(--fg-inverse); padding: 72px var(--space-8) 32px; border-top: 1px solid color-mix(in oklab, var(--brand) 45%, transparent); }
[data-theme="dark"] footer { background: #0b0a10; color: var(--fg); }
[data-theme="high-contrast"] footer { background: var(--bg); color: var(--fg); border-top: 2px solid var(--brand); }
.footer-inner { max-width: var(--maxw); margin: 0 auto; }

/* The line the organization is named for — opens the footer on every page. */
.footer-rumi {
  font-family: var(--font-display); font-style: italic; font-weight: 500;
  font-size: clamp(1.4rem, 1.1rem + 1.6vw, 2.4rem);
  line-height: 1.3; letter-spacing: -.01em;
  max-width: 22ch; margin-bottom: 12px; text-wrap: balance;
}
.footer-rumi em { color: var(--brand); font-style: inherit; }
.footer-rumi-cite { font-family: var(--font-body); font-size: .78rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; opacity: .6; display: block; margin-bottom: 56px; }
[data-theme="dark"] .footer-rumi-cite, [data-theme="high-contrast"] .footer-rumi-cite { color: var(--fg-muted); opacity: 1; }

.footer-top { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 48px; }
.footer-brand p { font-size: .92rem; opacity: .65; margin-top: 16px; max-width: 300px; line-height: 1.65; }
[data-theme="dark"] .footer-brand p, [data-theme="high-contrast"] .footer-brand p { color: var(--fg-muted); opacity: 1; }
.footer-col h4 { font-family: var(--font-body); font-size: .75rem; font-weight: 800; letter-spacing: .14em; text-transform: uppercase; opacity: .55; margin-bottom: 16px; }
[data-theme="dark"] .footer-col h4, [data-theme="high-contrast"] .footer-col h4 { color: var(--fg-muted); opacity: 1; }
.footer-col ul { list-style: none; display: flex; flex-direction: column; gap: 10px; }
.footer-col a { color: var(--fg-inverse); font-size: .9rem; opacity: .75; transition: opacity .15s, color .15s; }
.footer-col a:hover { opacity: 1; color: var(--brand); }
[data-theme="dark"] .footer-col a, [data-theme="high-contrast"] .footer-col a { color: var(--fg); opacity: .85; }
[data-theme="dark"] .footer-col a:hover, [data-theme="high-contrast"] .footer-col a:hover { color: var(--brand); opacity: 1; }
.footer-social { display: flex; gap: 10px; margin-top: 20px; }
.footer-social a { width: 38px; height: 38px; border-radius: 50%; border: 1px solid rgba(255,255,255,.2); display: flex; align-items: center; justify-content: center; color: currentColor; font-size: 17px; opacity: .8; transition: opacity .15s, background .15s, border-color .15s, color .15s; }
.footer-social a:hover { opacity: 1; background: var(--brand); border-color: var(--brand); color: var(--brand-fg); }
[data-theme="dark"] .footer-social a, [data-theme="high-contrast"] .footer-social a { border-color: var(--border-strong); color: var(--fg); }
[data-theme="dark"] .footer-social a:hover, [data-theme="high-contrast"] .footer-social a:hover { color: var(--brand-fg); }
.footer-bottom { border-top: 1px solid rgba(255,255,255,.1); padding-top: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
[data-theme="dark"] .footer-bottom, [data-theme="high-contrast"] .footer-bottom { border-top-color: var(--border); }
.footer-bottom p { font-size: .82rem; opacity: .55; }
[data-theme="dark"] .footer-bottom p, [data-theme="high-contrast"] .footer-bottom p { color: var(--fg-muted); opacity: 1; }
.footer-logo { display: flex; align-items: center; }
.footer-logo img,
.footer-logo .footer-logo-svg { height: 32px; width: auto; display: block; }
/* Re-tone the inline SVG logo for the dark footer: the wordmark inherits
   the footer's foreground color instead of brand gold, which would
   otherwise fight the Rumi line for attention. The eyes keep --accent. */
.footer-logo .footer-logo-svg { --brand: currentColor; }

/* ── PROSE (legal / long-form text pages) ────── */
/* Used by /privacy and any future plain-text policy pages. Kept narrow
   so line lengths stay readable and the typography matches the rest of
   the site (display font for headings, body font for paragraphs). */
.prose { color: var(--fg); font-size: 1rem; line-height: 1.7; }
.prose h2 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; letter-spacing: -.01em; color: var(--fg); margin: 36px 0 12px; }
.prose h2:first-child { margin-top: 0; }
.prose p { margin: 0 0 14px; color: var(--fg-muted); }
.prose ul { margin: 0 0 14px; padding-left: 22px; color: var(--fg-muted); }
.prose ul li { margin-bottom: 6px; }
.prose a { color: var(--brand); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 2px; }
.prose a:hover { color: var(--brand-hover); }
.prose code { font-family: var(--font-mono, ui-monospace, monospace); font-size: .9em; background: var(--bg-subtle); padding: 1px 6px; border-radius: 4px; }
.prose strong { color: var(--fg); font-weight: 600; }

/* ── FILTERS (for media/docs) ────── */
.filter-bar { display: flex; gap: 8px; margin-bottom: 36px; flex-wrap: wrap; align-items: center; }
.filter-label { font-family: var(--font-body); font-size: .72rem; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--fg-muted); margin-right: 10px; }
.filter-pill { font-family: var(--font-body); font-size: .82rem; font-weight: 700; color: var(--fg-muted); background: transparent; border: 1.5px solid var(--border); padding: 7px 15px; border-radius: var(--radius-full); cursor: pointer; transition: all .15s; }
.filter-pill:hover { border-color: var(--border-strong); color: var(--fg); }
.filter-pill.active { background: var(--brand); color: var(--brand-fg); border-color: var(--brand); }

.secure-note { display: flex; align-items: center; gap: 8px; font-size: .82rem; color: var(--fg-muted); padding: 10px 14px; background: var(--bg-subtle); border-radius: var(--radius-md); margin-bottom: 14px; }
.secure-note i { color: var(--brand); font-size: 16px; }
/* Donation page notice: this form is intent-only, no payment is taken.
   Slightly louder than .secure-note so donors actually read it before
   submitting. */
.donate-payment-notice {
  display: flex; align-items: flex-start; gap: 10px;
  font-size: .9rem; line-height: 1.55; color: var(--fg);
  padding: 14px 16px;
  background: var(--brand-subtle);
  border: 1px solid color-mix(in oklab, var(--brand) 35%, var(--border));
  border-radius: var(--radius-md);
  margin-bottom: 18px;
}
.donate-payment-notice i { color: var(--brand); font-size: 18px; flex-shrink: 0; line-height: 1.4; }
.donate-payment-notice strong { color: var(--fg); }
