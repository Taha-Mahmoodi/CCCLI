/*
 * Projects — "Sight Beyond Sight" (TEWW_REDESIGN_SPEC.md §5).
 * Listing: editorial night cards, featured-first (the flagship Third Eye
 * Kit spans the grid), oversized Literata index numerals, gold-outline
 * tag chips, whole card is the link.
 * Detail: flat night hero + gold hairline, status/focus as a hairline
 * table, prose sections separated by hairlines.
 * All colors via tokens — works in night / Day / high-contrast.
 */

/* ── Listing hero ─────────────────────────────────────────────── */
.proj-hero {
  position: relative;
  overflow: hidden;
  padding: clamp(72px, 10vw, 120px) var(--space-8) clamp(48px, 7vw, 80px);
  border-bottom: 1px solid var(--border);
  background: var(--bg);
}
/* One echo-ripple motif per viewport: thin concentric arcs radiating
   from beyond the top-right corner, fading toward the text. */
.proj-hero-ripple {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: repeating-radial-gradient(
    circle at 88% -30%,
    color-mix(in oklab, var(--brand) 28%, transparent) 0 1px,
    transparent 1px 64px
  );
  -webkit-mask-image: radial-gradient(circle at 88% -30%, #000 0%, transparent 72%);
  mask-image: radial-gradient(circle at 88% -30%, #000 0%, transparent 72%);
}
[data-theme="high-contrast"] .proj-hero-ripple { display: none; }

.proj-hero-inner { position: relative; max-width: var(--maxw); margin: 0 auto; }
.proj-hero-title {
  font-family: var(--font-display);
  font-size: var(--text-hero);
  font-weight: 600;
  letter-spacing: -.015em;
  line-height: 1.05;
  color: var(--fg);
  margin: 0 0 18px;
  text-wrap: balance;
  max-width: 18ch;
}
.proj-hero-title em { font-style: italic; color: var(--brand); }
.proj-hero-sub {
  font-size: 1.1rem;
  line-height: 1.65;
  color: var(--fg-muted);
  max-width: 62ch;
  margin: 0;
}
.proj-hero-sub em { font-style: italic; color: var(--fg); }

/* ── Listing grid ─────────────────────────────────────────────── */
.proj-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; }

.proj-card {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: clamp(18px, 3vw, 28px);
  padding: clamp(24px, 3.5vw, 36px);
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  color: inherit;
  text-decoration: none;
}
.proj-card-link { transition: transform .2s, border-color .2s, box-shadow .2s; }
.proj-card-link:hover {
  transform: translateY(-2px);
  border-color: var(--border-strong);
  box-shadow: var(--shadow-md);
}

/* Featured (first) card — the flagship spans the grid, gold hairline top. */
.proj-card-featured { grid-column: 1 / -1; padding: clamp(32px, 5vw, 56px); }
.proj-card-featured::before {
  content: '';
  position: absolute;
  top: -1px;
  left: clamp(24px, 5vw, 56px);
  right: clamp(24px, 5vw, 56px);
  height: 2px;
  background: var(--brand);
  border-radius: 2px;
}

/* Oversized Literata index numeral (decorative, aria-hidden). */
.proj-num {
  font-family: var(--font-display);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  font-size: clamp(1.9rem, 3.2vw, 2.6rem);
  line-height: 1;
  color: var(--brand);
  flex-shrink: 0;
  margin-top: 2px;
}
.proj-card-featured .proj-num { font-size: clamp(3rem, 6vw, 4.5rem); }

.proj-body { flex: 1; min-width: 0; }
.proj-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  flex-wrap: wrap;
  margin-bottom: 16px;
}
.proj-icon {
  width: 48px;
  height: 48px;
  border-radius: var(--radius-md);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  background: var(--brand-subtle);
  color: var(--brand);
  border: 1px solid color-mix(in oklab, var(--brand) 30%, transparent);
  flex-shrink: 0;
}
/* Tag as a small gold-outline chip, e.g. "Hardware · Validated". */
.proj-chip {
  display: inline-flex;
  align-items: center;
  padding: 6px 12px;
  border: 1px solid color-mix(in oklab, var(--brand) 60%, transparent);
  border-radius: var(--radius-full);
  color: var(--brand);
  font-size: .7rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
}
.proj-title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 600;
  letter-spacing: -.015em;
  line-height: 1.2;
  color: var(--fg);
  margin: 0 0 8px;
  text-wrap: balance;
}
.proj-card-featured .proj-title { font-size: clamp(1.75rem, 3vw, 2.5rem); }
.proj-desc {
  font-size: .95rem;
  line-height: 1.65;
  color: var(--fg-muted);
  max-width: 58ch;
  margin: 0;
}
.proj-card-featured .proj-desc { font-size: 1.05rem; }
.proj-more {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 18px;
  font-size: .85rem;
  font-weight: 700;
  color: var(--brand);
  transition: gap .2s, color .2s;
}
.proj-card-link:hover .proj-more {
  gap: 10px;
  color: var(--brand-hover);
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* ── "Rest of the ecosystem" — flat editorial, gold hairline frame ── */
.proj-other-section { padding-top: 0; }
.proj-other {
  max-width: 880px;
  margin: 0 auto;
  padding: clamp(32px, 5vw, 56px);
  border: 1px solid color-mix(in oklab, var(--brand) 40%, var(--border));
  border-radius: var(--radius-lg);
  background: transparent;
}
.proj-other-title {
  font-family: var(--font-display);
  font-size: clamp(1.5rem, 2.4vw, 2rem);
  font-weight: 600;
  letter-spacing: -.015em;
  line-height: 1.15;
  color: var(--fg);
  margin: 0 0 14px;
  text-wrap: balance;
}
.proj-other-title em { font-style: italic; color: var(--brand); }
.proj-other-body {
  font-size: 1.02rem;
  line-height: 1.75;
  color: var(--fg-muted);
  max-width: 68ch;
  margin: 0;
}
.proj-other-body strong { color: var(--fg); font-weight: 600; }
.proj-other-body em { font-style: italic; color: var(--fg); }

/* ── Project detail ───────────────────────────────────────────── */
.project-detail { padding-bottom: 80px; }

.pd-hero {
  background: var(--bg);
  border-bottom: 1px solid var(--border);
  padding: clamp(40px, 7vw, 80px) var(--space-8) clamp(36px, 6vw, 64px);
}
.pd-hero-inner { max-width: 840px; margin: 0 auto; }
.pd-back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  font-size: .85rem;
  font-weight: 700;
  color: var(--fg-muted);
  text-decoration: none;
  margin-bottom: 20px;
  transition: color .2s;
}
.pd-back:hover { color: var(--brand); text-decoration: underline; text-underline-offset: 3px; }

.pd-hero-icon {
  width: 60px;
  height: 60px;
  border-radius: var(--radius-lg);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 30px;
  background: var(--brand-subtle);
  color: var(--brand);
  border: 1px solid color-mix(in oklab, var(--brand) 30%, transparent);
  margin-bottom: 24px;
}
.pd-title {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 5vw, 3.5rem);
  font-weight: 600;
  letter-spacing: -.015em;
  line-height: 1.05;
  color: var(--fg);
  margin: 0 0 16px;
  text-wrap: balance;
}
.pd-title em { font-style: italic; color: var(--brand); }
.pd-standfirst {
  font-family: var(--font-display);
  font-size: clamp(1.05rem, 1.5vw, 1.3rem);
  font-weight: 400;
  line-height: 1.55;
  color: var(--fg-muted);
  max-width: 62ch;
  margin: 0;
}

/* Status / focus rows as a hairline table. */
.pd-meta {
  margin: 32px 0 0;
  max-width: 560px;
  border-top: 1px solid color-mix(in oklab, var(--brand) 50%, var(--border));
}
.pd-meta-row {
  display: grid;
  grid-template-columns: 110px 1fr;
  gap: 16px;
  align-items: baseline;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
}
.pd-meta-row dt {
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--brand);
}
.pd-meta-row dd {
  margin: 0;
  font-family: var(--font-display);
  font-size: 1rem;
  color: var(--fg);
  display: flex;
  align-items: center;
  gap: 10px;
}
.pd-status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--fg-subtle);
  flex-shrink: 0;
}
.pd-status-live .pd-status-dot { background: var(--brand); }
.pd-status-in-progress .pd-status-dot { background: var(--accent); }

/* Prose sections — hairline-separated editorial rows. */
.pd-body {
  max-width: 720px;
  margin: 0 auto;
  padding: clamp(40px, 7vw, 72px) var(--space-8) 0;
}
.pd-section {
  padding: clamp(28px, 4vw, 44px) 0;
  border-bottom: 1px solid var(--border);
  scroll-margin-top: calc(var(--header-height) + 16px);
}
.pd-section:first-child { padding-top: 0; }
.pd-section:last-child { border-bottom: none; }
.pd-section-eyebrow {
  font-family: var(--font-body);
  font-size: .72rem;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--brand);
  margin-bottom: 10px;
}
.pd-section-title {
  font-family: var(--font-display);
  font-size: clamp(1.45rem, 2.2vw, 1.9rem);
  font-weight: 600;
  letter-spacing: -.015em;
  line-height: 1.15;
  color: var(--fg);
  margin: 0 0 16px;
  text-wrap: balance;
}
.pd-section-body {
  font-size: 1.02rem;
  line-height: 1.72;
  color: var(--fg-muted);
  max-width: 68ch;
}
.pd-section-body strong { color: var(--fg); font-weight: 600; }
.pd-section-body em { font-style: italic; color: var(--fg); }

/* Support CTA — night card in a gold hairline frame. */
.pd-cta {
  max-width: 720px;
  margin-top: clamp(40px, 7vw, 72px);
  margin-inline: max(var(--space-8), calc((100% - 720px) / 2));
  padding: clamp(36px, 5vw, 56px) clamp(24px, 6vw, 48px);
  text-align: center;
  background: var(--bg-elevated);
  border: 1px solid color-mix(in oklab, var(--brand) 40%, var(--border));
  border-radius: var(--radius-lg);
}
.pd-cta h2 {
  font-family: var(--font-display);
  font-size: clamp(1.35rem, 2vw, 1.8rem);
  font-weight: 600;
  letter-spacing: -.015em;
  color: var(--fg);
  margin: 0 0 8px;
  text-wrap: balance;
}
.pd-cta p {
  color: var(--fg-muted);
  line-height: 1.6;
  margin: 0 auto 24px;
  max-width: 52ch;
}
.pd-cta-actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  justify-content: center;
}

/* ── High contrast: 2px borders, no translucent decoration ────── */
[data-theme="high-contrast"] .proj-card,
[data-theme="high-contrast"] .proj-chip,
[data-theme="high-contrast"] .proj-icon,
[data-theme="high-contrast"] .proj-other,
[data-theme="high-contrast"] .pd-hero-icon,
[data-theme="high-contrast"] .pd-cta { border-width: 2px; }
[data-theme="high-contrast"] .proj-icon,
[data-theme="high-contrast"] .pd-hero-icon { background: transparent; }

/* ── Responsive ───────────────────────────────────────────────── */
@media (max-width: 860px) {
  .proj-grid { grid-template-columns: 1fr; }
}
@media (max-width: 560px) {
  .proj-card { flex-direction: column; gap: 14px; }
  .pd-meta-row { grid-template-columns: 1fr; gap: 4px; }
}

/* ── Legacy .prog-card link styles ─────────────────────────────
   /projects no longer uses ProjectCard, but the HOME page still
   renders it (base .prog-card styles live in 02-base-sections.css).
   Kept here, tokenized, so home cards stay styled; delete once the
   home redesign stops consuming ProjectCard. */
.prog-card-link {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 18px;
  text-decoration: none;
  color: inherit;
  cursor: pointer;
  transition: transform .2s, border-color .2s, box-shadow .2s;
}
.prog-card-link:hover {
  transform: translateY(-2px);
  border-color: var(--border-strong);
  box-shadow: var(--shadow-md);
}
.prog-card-link:hover .prog-learn-more { color: var(--brand); gap: 10px; }
.prog-card-link .prog-tag { margin-top: 12px; }
.prog-learn-more {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  margin-top: 16px;
  font-size: .82rem;
  font-weight: 700;
  color: var(--fg-muted);
  transition: color .2s, gap .2s;
}
.prog-card-coming-soon { position: relative; border-style: dashed; }
.prog-card-coming-soon::before {
  content: 'Coming soon';
  position: absolute;
  top: 14px;
  right: 14px;
  font-size: .66rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent);
  background: var(--bg-subtle);
  border: 1px solid var(--border);
  padding: 4px 10px;
  border-radius: var(--radius-full);
}
