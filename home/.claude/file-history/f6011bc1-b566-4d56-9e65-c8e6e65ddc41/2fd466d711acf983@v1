"use client";

import * as React from "react";
import { X } from "lucide-react";
import { t } from "@/lib/i18n";

export interface DialogProps {
  open: boolean;
  onClose: () => void;
  title: string;
  children: React.ReactNode;
  /** Optional footer (e.g. action buttons). */
  footer?: React.ReactNode;
}

/**
 * Modal dialog built on the native <dialog> element, which gives us focus
 * trapping, Esc-to-close, and inert background for free. Labelled by its title.
 */
export function Dialog({ open, onClose, title, children, footer }: DialogProps) {
  const ref = React.useRef<HTMLDialogElement>(null);
  const titleId = React.useId();

  React.useEffect(() => {
    const dialog = ref.current;
    if (!dialog) return;
    if (open && !dialog.open) {
      // showModal isn't implemented in jsdom; fall back to the open attribute.
      try {
        dialog.showModal();
      } catch {
        dialog.open = true;
      }
    } else if (!open && dialog.open) {
      try {
        dialog.close();
      } catch {
        dialog.open = false;
      }
    }
  }, [open]);

  return (
    <dialog
      ref={ref}
      aria-labelledby={titleId}
      onClose={onClose}
      onClick={(e) => {
        // Close when the backdrop (the dialog element itself) is clicked.
        if (e.target === ref.current) onClose();
      }}
      className="m-auto w-[min(92vw,32rem)] rounded-lg border border-border bg-surface p-0 text-ink shadow-lg backdrop:bg-ink/40"
    >
      <div className="flex items-start justify-between gap-4 border-b border-border px-6 pt-5 pb-4">
        <h2 id={titleId} className="text-h3">
          {title}
        </h2>
        <button
          type="button"
          onClick={onClose}
          aria-label={t("safety.close")}
          className="-m-2 rounded-sm p-2 text-ink-soft hover:text-ink"
        >
          <X size={22} strokeWidth={2} aria-hidden="true" />
        </button>
      </div>
      <div className="px-6 py-5">{children}</div>
      {footer ? (
        <div className="flex flex-wrap justify-end gap-3 border-t border-border px-6 py-4">
          {footer}
        </div>
      ) : null}
    </dialog>
  );
}
