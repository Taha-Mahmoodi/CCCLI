import * as React from "react";
import { t } from "@/lib/i18n";

let idCounter = 0;
function useFieldId(provided?: string) {
  const reactId = React.useId();
  return provided ?? reactId ?? `field-${++idCounter}`;
}

export interface FieldProps {
  id?: string;
  label: string;
  /** Optional helper text shown under the label, tied via aria-describedby. */
  hint?: string;
  /** Error message; when set, the field is marked invalid and described by it. */
  error?: string;
  required?: boolean;
  children: (props: {
    id: string;
    "aria-describedby"?: string;
    "aria-invalid"?: boolean;
    "aria-required"?: boolean;
  }) => React.ReactNode;
}

/**
 * Field wrapper: a real <label> tied to its control, optional hint and error,
 * wired through aria-describedby / aria-invalid. Use with <Input>/<Select>.
 */
export function Field({
  id,
  label,
  hint,
  error,
  required,
  children,
}: FieldProps) {
  const fieldId = useFieldId(id);
  const hintId = hint ? `${fieldId}-hint` : undefined;
  const errorId = error ? `${fieldId}-error` : undefined;
  const describedBy = [hintId, errorId].filter(Boolean).join(" ") || undefined;

  return (
    <div className="flex flex-col gap-1.5">
      <label htmlFor={fieldId} className="text-base font-bold text-ink">
        {label}
        {required ? (
          <span className="font-normal text-ink-soft">
            {" "}
            ({t("ui.required")})
          </span>
        ) : null}
      </label>
      {hint ? (
        <p id={hintId} className="text-sm text-ink-soft">
          {hint}
        </p>
      ) : null}
      {children({
        id: fieldId,
        "aria-describedby": describedBy,
        "aria-invalid": error ? true : undefined,
        "aria-required": required || undefined,
      })}
      {error ? (
        <p id={errorId} className="text-sm font-semibold text-alert" role="alert">
          {error}
        </p>
      ) : null}
    </div>
  );
}

export const Input = React.forwardRef<
  HTMLInputElement,
  React.InputHTMLAttributes<HTMLInputElement>
>(function Input({ className = "", ...rest }, ref) {
  return (
    <input
      ref={ref}
      className={[
        "min-h-12 rounded-btn border border-border-strong bg-surface px-3.5 py-2.5",
        "text-base text-ink placeholder:text-ink-faint",
        "aria-[invalid=true]:border-alert aria-[invalid=true]:border-2",
        className,
      ]
        .filter(Boolean)
        .join(" ")}
      {...rest}
    />
  );
});
