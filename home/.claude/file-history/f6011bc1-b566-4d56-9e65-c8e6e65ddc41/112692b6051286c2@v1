"use client";

import * as React from "react";
import { Check } from "lucide-react";

export interface ChipProps {
  children: React.ReactNode;
  selected?: boolean;
  onClick?: () => void;
  /** Accessible name when the visible text needs more context for SR users. */
  ariaLabel?: string;
}

/**
 * Toggleable chip. Selection is conveyed by a 2px teal border, tint fill AND a
 * check icon plus aria-pressed — never by color alone (SPEC §10).
 */
export function Chip({ children, selected, onClick, ariaLabel }: ChipProps) {
  return (
    <button
      type="button"
      onClick={onClick}
      aria-pressed={!!selected}
      aria-label={ariaLabel}
      className={[
        "inline-flex min-h-11 items-center gap-1.5 rounded-pill px-4 font-body text-sm font-bold",
        "transition-colors duration-200",
        selected
          ? "border-2 border-primary bg-primary-tint text-primary-dark"
          : "border border-border-strong bg-surface text-ink hover:bg-primary-tint/50",
      ].join(" ")}
    >
      {selected ? <Check size={16} strokeWidth={2.5} aria-hidden="true" /> : null}
      {children}
    </button>
  );
}
