/* ── PAGE HERO (shared subpage hero — night editorial) ─────────── */
/* Class contract (.page-hero / .page-hero-inner / h1 / p) is shared by every
   subpage — changes here must stay additive and theme-token driven. */
.page-hero { position: relative; overflow: hidden; padding: 88px var(--space-8) 64px; border-bottom: 1px solid color-mix(in oklab, var(--brand) 30%, var(--border)); background: var(--bg); }
.page-hero-inner { position: relative; z-index: 1; max-width: var(--maxw); margin: 0 auto; }
.page-hero h1 { font-family: var(--font-display); font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem); font-weight: 600; letter-spacing: -.015em; color: var(--fg); margin-bottom: 16px; line-height: 1.08; text-wrap: balance; }
/* House style: CMS titles carry <em> — Literata italic in gold. */
.page-hero h1 em { color: var(--brand); font-style: italic; }
.page-hero p { font-size: 1.1rem; color: var(--fg-muted); max-width: 700px; line-height: 1.65; }

/* Opt-in echo-ripple motif (spec §1 — sound made visible). CSS-only,
   pointer-transparent, one motif per viewport. */
.page-hero--ripple::before {
  content: ''; position: absolute; top: 50%; right: -150px;
  width: 420px; height: 420px; transform: translateY(-50%);
  border-radius: 50%; pointer-events: none;
  border: 1px solid color-mix(in oklab, var(--brand) 30%, transparent);
  box-shadow:
    0 0 0 70px color-mix(in oklab, var(--brand) 10%, transparent),
    0 0 0 150px color-mix(in oklab, var(--brand) 6%, transparent),
    0 0 0 240px color-mix(in oklab, var(--brand) 3%, transparent);
}
[data-theme="high-contrast"] .page-hero--ripple::before { display: none; }

/* ── DONATE ───────────────────── */
.donate-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }

/* The widget panel: elevated night surface, gold hairline top (spec §3). */
.donate-widget { position: relative; background: var(--bg-elevated); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px; overflow: hidden; }
.donate-widget::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px; background: var(--brand); }
[data-theme="high-contrast"] .donate-widget { border-width: 2px; }

.donate-toggle { display: flex; background: var(--bg); border: 1px solid var(--border-strong); border-radius: var(--radius-full); padding: 4px; gap: 4px; margin-bottom: 28px; }
.donate-toggle button { flex: 1; min-height: 44px; padding: 10px 20px; background: none; border: none; border-radius: var(--radius-full); font-family: var(--font-body); font-size: .92rem; font-weight: 700; color: var(--fg-muted); cursor: pointer; transition: background .2s ease, color .2s ease; display: inline-flex; align-items: center; justify-content: center; gap: 6px; }
.donate-toggle button:hover { color: var(--fg); }
/* Active tab = gold fill + night text (never light-on-gold). The fill,
   aria-selected, and label weight carry the state — not hue alone. */
.donate-toggle button.active { background: var(--brand); color: var(--brand-fg); }
.donate-toggle button.active .t-label { color: inherit; }

/* Amount input — free-text, donor decides (v2 content update). */
.custom-amount { display: flex; align-items: center; gap: 10px; }
.custom-amount-solo { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; }
.custom-amount-solo .custom-amount-label {
  font-family: var(--font-body); font-size: .78rem; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase; color: var(--fg);
}
.custom-amount-solo .custom-amount-input {
  display: flex; align-items: center; gap: 10px;
  background: var(--bg);
  border: 1px solid var(--border-strong);
  border-radius: var(--radius-md);
  padding: 16px 20px;
  transition: border-color .15s, box-shadow .15s;
}
.custom-amount-solo .custom-amount-input:focus-within {
  border-color: var(--brand);
  box-shadow: 0 0 0 3px var(--brand-subtle);
}
.custom-amount-solo .cur {
  font-family: var(--font-display); font-size: 1.6rem; font-weight: 600;
  color: var(--brand);
}
.custom-amount-solo input {
  flex: 1; border: none; background: transparent; outline: none;
  font-family: var(--font-display); font-size: 1.6rem; font-weight: 600;
  letter-spacing: -.01em; font-variant-numeric: tabular-nums;
  color: var(--fg); min-width: 0;
}
.custom-amount-solo input::placeholder { color: var(--fg-subtle); font-weight: 400; }
.custom-amount-solo .custom-amount-suffix {
  font-family: var(--font-display); font-size: 1rem; font-style: italic;
  color: var(--fg-muted); flex-shrink: 0;
}
.custom-amount-help {
  font-size: .82rem; color: var(--fg-muted); margin: 2px 2px 0;
}

/* Impact breakdown — flat editorial hairline rows (spec §5). */
.donate-impact { background: transparent; border-top: 1px solid var(--brand); padding: 26px 0 4px; }
.donate-impact h3 { font-family: var(--font-display); font-size: 1.35rem; font-weight: 600; letter-spacing: -.01em; color: var(--fg); margin-bottom: 10px; }
.donate-impact .lead { color: var(--fg-muted); margin-bottom: 18px; font-size: .95rem; line-height: 1.65; }
.donate-impact-foot { color: var(--fg-muted); margin-top: 18px; font-size: .9rem; line-height: 1.6; font-style: italic; }
.impact-row { display: flex; align-items: flex-start; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--border); }
.impact-row:first-of-type { border-top: 1px solid var(--border); }
.impact-row:last-of-type { border-bottom: none; }
.impact-icon { width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-strong); background: transparent; color: var(--brand); display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; }
.impact-row .text { flex: 1; }
.impact-row .text strong { font-family: var(--font-display); font-weight: 600; color: var(--fg); display: block; font-size: 1rem; letter-spacing: -.01em; }
.impact-row .text span { font-size: .85rem; color: var(--fg-muted); line-height: 1.55; }

/* Shared form fields (donate details + volunteer form). */
.pay-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
.pay-field label { font-family: var(--font-body); font-size: .78rem; font-weight: 700; color: var(--fg); letter-spacing: .04em; }
.pay-field input, .pay-field select { font-family: var(--font-body); font-size: .95rem; min-height: 46px; color: var(--fg); background: var(--bg); border: 1px solid var(--border-strong); border-radius: var(--radius-md); padding: 11px 14px; outline: none; transition: border-color .15s, box-shadow .15s; }
.pay-field input::placeholder { color: var(--fg-subtle); }
.pay-field input:focus, .pay-field select:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-subtle); }
.pay-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
