import * as THREE from "three";
import {
  effectiveStage,
  isDust,
  mulberry32,
  remnantFactor,
  type Project,
  type Stage,
} from "./data";
import { softSprite } from "./scene";

// Stage palettes: core -> rim gradient per evolution stage. Warm-gold dominant,
// blue reserved for the top tier — deliberately inverts the cyan-on-black cliché.
export const STAGE_PALETTE: Record<Stage, { core: number; rim: number; glow: number }> = {
  "nebula": { core: 0xb9a6dd, rim: 0x6d5a96, glow: 0.34 },
  "red-dwarf": { core: 0xffb08a, rim: 0xa5432e, glow: 0.5 },
  "main-sequence": { core: 0xfff3da, rim: 0xd9a05e, glow: 0.75 },
  "blue-giant": { core: 0xeaf2ff, rim: 0x7fa8f4, glow: 1.0 },
  "black-hole": { core: 0x120b07, rim: 0xff9d5c, glow: 0.9 },
};

export interface GalaxyNode {
  group: THREE.Group;
  project: Project;
  /** world-space radius, used for camera framing */
  radius: number;
  spinSpeed: number;
  /** the aggregate particle cloud's material, for tier-transition fades */
  cloudMat: THREE.PointsMaterial;
  /** the core bulge sprite's material, for fades + hover brightening */
  nucleusMat: THREE.SpriteMaterial;
  /** invisible sphere for reliable raycast picking of the particle cloud */
  hitSphere: THREE.Mesh;
  /** cloud geometry + its full particle count, for distance-based LOD */
  cloudGeo: THREE.BufferGeometry;
  fullCount: number;
}

/** Aggregate galaxy shape for the multi-galaxy tier. Semantic LOD tier 1:
 *  one particle swirl per project — individual stars/planets never render here. */
export interface GalaxySignature {
  core: number;
  rim: number;
  accretion: number;
}

export function buildGalaxy(
  project: Project,
  now: number,
  sprite: THREE.Texture,
  density = 1,
  signature?: GalaxySignature,
): GalaxyNode {
  const stage = effectiveStage(project, now);
  const dust = isDust(project, now);
  // dust: shapeless, desaturated, barely lit — the terminal neglect state
  // you have to work back up from (per the vision)
  const sig = stage === "black-hole" ? signature : undefined;
  const pal = dust
    ? { core: 0x6a6259, rim: 0x38342d, glow: 0.16 }
    : sig
      ? { core: sig.core, rim: sig.rim, glow: STAGE_PALETTE["black-hole"].glow }
      : STAGE_PALETTE[stage];
  const rnd = mulberry32(project.id.length * 7919 + project.noteCount);

  const radius = 8 + Math.sqrt(project.noteCount) * 0.9;
  // density scales the global particle budget down at company scale —
  // the semantic-LOD premise: aggregate impressions, never raw note counts
  const count = Math.max(
    600,
    Math.round(Math.min(2200 + project.noteCount * 10, 14000) * density),
  );
  const arms = stage === "nebula" || dust ? 0 : 2 + Math.floor(rnd() * 3);
  const dim = remnantFactor(project, now) * pal.glow;
  const puff = dust ? 3.2 : 1; // dust billows vertically instead of holding a disc

  const pos = new Float32Array(count * 3);
  const col = new Float32Array(count * 3);
  const core = new THREE.Color(pal.core);
  const rim = new THREE.Color(pal.rim);
  const c = new THREE.Color();

  for (let i = 0; i < count; i++) {
    const t = Math.pow(rnd(), 0.6); // density bias toward the core
    const r = t * radius;
    let angle = rnd() * Math.PI * 2;
    if (arms > 0) {
      // logarithmic spiral arms with gaussian scatter that widens outward
      const arm = Math.floor(rnd() * arms);
      const armAngle = (arm / arms) * Math.PI * 2;
      const swirl = t * 2.6;
      const scatter = (rnd() - 0.5 + rnd() - 0.5) * (0.18 + t * 0.55);
      angle = armAngle + swirl + scatter;
    }
    const y = (rnd() - 0.5 + rnd() - 0.5) * radius * 0.09 * (1.25 - t) * puff;
    pos[i * 3] = Math.cos(angle) * r;
    pos[i * 3 + 1] = y;
    pos[i * 3 + 2] = Math.sin(angle) * r;

    c.lerpColors(core, rim, Math.pow(t, 0.8)).multiplyScalar(dim * 1.22);
    col[i * 3] = c.r;
    col[i * 3 + 1] = c.g;
    col[i * 3 + 2] = c.b;
  }

  const geo = new THREE.BufferGeometry();
  geo.setAttribute("position", new THREE.BufferAttribute(pos, 3));
  geo.setAttribute("color", new THREE.BufferAttribute(col, 3));

  // thinner clouds get slightly larger points so luminosity holds (splat trick)
  const sizeComp = Math.min(1 / Math.sqrt(density), 1.6);
  const mat = new THREE.PointsMaterial({
    size: (dust ? 3.1 : stage === "nebula" ? 2.2 : 1.35) * sizeComp,
    map: sprite,
    vertexColors: true,
    transparent: true,
    depthWrite: false,
    blending: THREE.AdditiveBlending,
    sizeAttenuation: true,
  });

  const group = new THREE.Group();
  group.add(new THREE.Points(geo, mat));

  // luminous nucleus — galaxies have bright bulges, not hollow centers
  const nucleusMat = new THREE.SpriteMaterial({
    map: sprite,
    color: new THREE.Color(pal.core).multiplyScalar(dim),
    transparent: true,
    opacity: dust ? 0.12 : 0.55,
    blending: THREE.AdditiveBlending,
    depthWrite: false,
  });
  const nucleus = new THREE.Sprite(nucleusMat);
  nucleus.scale.setScalar(radius * (stage === "black-hole" ? 0.5 : 0.9));
  group.add(nucleus);

  const hitSphere = new THREE.Mesh(
    new THREE.SphereGeometry(radius * 1.05, 12, 12),
    new THREE.MeshBasicMaterial({ visible: false }),
  );
  hitSphere.userData.projectId = project.id;
  group.add(hitSphere);

  if (stage === "black-hole") {
    group.add(...blackHoleExtras(radius, dim, sig?.accretion ?? 0xff9d5c));
  }

  // slight random tilt so the sky doesn't read as a flat sheet of discs
  group.rotation.set((rnd() - 0.5) * 0.5, rnd() * Math.PI * 2, (rnd() - 0.5) * 0.5);

  return {
    group,
    project,
    radius,
    spinSpeed: (0.02 + rnd() * 0.035) * (stage === "black-hole" ? 2.2 : 1),
    cloudMat: mat,
    nucleusMat,
    hitSphere,
    cloudGeo: geo,
    fullCount: count,
  };
}

/** Distance-based decimation: far galaxies draw a random subset of their
 *  particles (positions are generated in random order, so a draw-range cut
 *  reads as thinning, not clipping). Near = full detail. */
export function applyGalaxyLOD(
  nodes: GalaxyNode[],
  cameraPos: THREE.Vector3,
): void {
  const wp = new THREE.Vector3();
  for (const n of nodes) {
    n.group.getWorldPosition(wp);
    const d = cameraPos.distanceTo(wp);
    const factor = d < 300 ? 1 : d < 700 ? 0.45 : 0.16;
    n.cloudGeo.setDrawRange(0, Math.ceil(n.fullCount * factor));
  }
}

/** Dark core + accretion ring + faint tilted photon ring. Gravity, not brightness. */
function blackHoleExtras(
  radius: number,
  dim: number,
  accretion = 0xff9d5c,
): THREE.Object3D[] {
  const coreGeo = new THREE.SphereGeometry(radius * 0.16, 32, 32);
  const coreMat = new THREE.MeshBasicMaterial({ color: 0x000000 });
  const core = new THREE.Mesh(coreGeo, coreMat);

  const ringGeo = new THREE.TorusGeometry(radius * 0.24, radius * 0.018, 16, 96);
  const ringMat = new THREE.MeshBasicMaterial({
    color: new THREE.Color(accretion).multiplyScalar(dim * 1.6),
    transparent: true,
    opacity: 0.9,
  });
  const ring = new THREE.Mesh(ringGeo, ringMat);
  ring.rotation.x = Math.PI / 2.15;

  // photon-ring hint: larger, dimmer, tilted against the accretion plane
  const photonGeo = new THREE.TorusGeometry(radius * 0.34, radius * 0.007, 12, 96);
  const photonMat = new THREE.MeshBasicMaterial({
    color: new THREE.Color(accretion).clone().lerp(new THREE.Color(0xffffff), 0.35).multiplyScalar(dim),
    transparent: true,
    opacity: 0.45,
  });
  const photon = new THREE.Mesh(photonGeo, photonMat);
  photon.rotation.x = Math.PI / 3.4;
  photon.rotation.z = Math.PI / 5;

  return [core, ring, photon];
}

/** Flattened-disc layout with min-distance rejection sampling; biggest lands
 *  nearest the origin so the opening flight has a natural destination. */
export function layoutGalaxies(nodes: GalaxyNode[], seed = 11): void {
  const rnd = mulberry32(seed);
  const sorted = [...nodes].sort((a, b) => b.radius - a.radius);
  const placed: { x: number; z: number; r: number }[] = [];
  // spacing tuned at 50 galaxies; widen rings as the sky grows so a
  // company-scale universe doesn't interpenetrate
  const spread = Math.max(1, Math.sqrt(nodes.length / 50));

  sorted.forEach((node, i) => {
    const ringR = (88 + Math.pow(i, 0.78) * 46) * spread;
    let x = 0;
    let z = 0;
    for (let attempt = 0; attempt < 40; attempt++) {
      const a = rnd() * Math.PI * 2;
      const r = ringR * (0.75 + rnd() * 0.5);
      x = Math.cos(a) * r;
      z = Math.sin(a) * r;
      const pad = node.radius * 2.6;
      if (placed.every((p) => Math.hypot(p.x - x, p.z - z) > p.r + pad)) break;
    }
    placed.push({ x, z, r: node.radius * 2.6 });
    node.group.position.set(x, (rnd() - 0.5) * 130, z);
  });

  // space bends toward black holes: nudge every other galaxy slightly
  // toward its nearest black hole — gravity you can feel in the layout
  const holes = nodes.filter(
    (n) => n.project.milestoneMarked,
  );
  if (holes.length === 0) return;
  const pull = new THREE.Vector3();
  for (const n of nodes) {
    if (n.project.milestoneMarked) continue;
    let nearest = holes[0];
    let best = Infinity;
    for (const h of holes) {
      const d = n.group.position.distanceToSquared(h.group.position);
      if (d < best) {
        best = d;
        nearest = h;
      }
    }
    pull.subVectors(nearest.group.position, n.group.position).multiplyScalar(0.07);
    n.group.position.add(pull);
  }
}
