import { describe, expect, it } from "vitest";
import {
  burstEnvelope,
  curvePoint,
  DECAY_DAYS,
  decayCountdown,
  declutterKeep,
  earnedStage,
  effectiveStage,
  isDust,
  labelOpacity,
  mockNotes,
  mockProjects,
  mockVaults,
  orbitRadiusByRank,
  rankNotesByRecency,
  remnantFactor,
  uniquePairs,
  type Project,
} from "./data";

const DAY = 86_400_000;
const NOW = 1_800_000_000_000;

function proj(over: Partial<Project>): Project {
  return {
    id: "t",
    name: "Test",
    noteCount: 100,
    contributors: 3,
    cadence: 20,
    createdAt: NOW - 200 * DAY,
    lastActivity: NOW,
    milestoneMarked: false,
    ...over,
  };
}

describe("earnedStage", () => {
  it("new empty project is a nebula", () => {
    expect(
      earnedStage(proj({ cadence: 0.2, contributors: 0, createdAt: NOW - 2 * DAY })),
    ).toBe("nebula");
  });
  it("sustained multi-contributor activity reaches blue giant", () => {
    expect(earnedStage(proj({ cadence: 30, contributors: 6 }))).toBe("blue-giant");
  });
  it("milestone always wins: black hole", () => {
    expect(earnedStage(proj({ milestoneMarked: true }))).toBe("black-hole");
  });
});

describe("decay", () => {
  it("active project does not decay", () => {
    const p = proj({ cadence: 30, contributors: 6 });
    expect(effectiveStage(p, NOW)).toBe("blue-giant");
  });
  it("cools one step after its stage window", () => {
    const p = proj({
      cadence: 30,
      contributors: 6,
      lastActivity: NOW - (DECAY_DAYS["blue-giant"] + 1) * DAY,
    });
    expect(effectiveStage(p, NOW)).toBe("main-sequence");
  });
  it("countdown is visible and decreases toward the next step", () => {
    const p = proj({
      cadence: 30,
      contributors: 6,
      lastActivity: NOW - 2 * DAY,
    });
    const days = decayCountdown(p, NOW);
    expect(days).not.toBeNull();
    expect(days!).toBeCloseTo(DECAY_DAYS["blue-giant"] - 2, 5);
  });
  it("terminal neglect collapses to dust; activity and black holes never dust", () => {
    const neglected = proj({
      cadence: 30,
      contributors: 6,
      lastActivity: NOW - 120 * DAY,
    });
    expect(isDust(neglected, NOW)).toBe(true);
    expect(isDust(proj({ cadence: 30, contributors: 6 }), NOW)).toBe(false);
    expect(
      isDust(proj({ milestoneMarked: true, lastActivity: NOW - 400 * DAY }), NOW),
    ).toBe(false);
  });
  it("black hole never reverts, only dims toward a remnant", () => {
    const p = proj({ milestoneMarked: true, lastActivity: NOW - 400 * DAY });
    expect(effectiveStage(p, NOW)).toBe("black-hole");
    expect(remnantFactor(p, NOW)).toBe(0.25);
    expect(remnantFactor(proj({ milestoneMarked: true }), NOW)).toBe(1);
  });
});

describe("vaults", () => {
  it("is deterministic and note counts sum exactly to the project total", () => {
    const p = proj({ noteCount: 137 });
    const a = mockVaults(p);
    expect(a).toEqual(mockVaults(p));
    expect(a.reduce((s, v) => s + v.noteCount, 0)).toBe(137);
    expect(a.every((v) => v.noteCount >= 1)).toBe(true);
  });
});

describe("notes", () => {
  it("is deterministic, capped, with bounded moons", () => {
    const v = mockVaults(proj({ noteCount: 300 }))[0];
    const a = mockNotes(v);
    expect(a).toEqual(mockNotes(v));
    expect(a.length).toBeLessThanOrEqual(14);
    expect(a.every((n) => n.size >= 1 && n.subCount <= 3)).toBe(true);
  });
  it("fresh notes take inner ranks; rank spacing never crosses", () => {
    const v = mockVaults(proj({ noteCount: 60 }))[0];
    const ranked = rankNotesByRecency(mockNotes(v));
    for (let i = 1; i < ranked.length; i++) {
      expect(ranked[i - 1].lastActivity).toBeGreaterThanOrEqual(ranked[i].lastActivity);
      expect(orbitRadiusByRank(i) - orbitRadiusByRank(i - 1)).toBeCloseTo(0.75, 10);
    }
    expect(orbitRadiusByRank(0)).toBeGreaterThan(1.7); // clear of star + corona
  });
});

describe("burstEnvelope", () => {
  it("builds up, detonates, and decays", () => {
    const start = burstEnvelope(0);
    expect(start.shock).toBe(0);
    expect(start.contract).toBe(1);
    const peak = burstEnvelope(0.25);
    expect(peak.flash).toBeGreaterThan(0.8);
    const end = burstEnvelope(1);
    expect(end.flash).toBe(0);
    expect(end.shock).toBe(1);
  });
});

describe("curvePoint", () => {
  it("starts at from and ends at to", () => {
    const from = { x: 0, y: 0, z: 0 };
    const ctrl = { x: 5, y: 20, z: 5 };
    const to = { x: 10, y: 0, z: 10 };
    expect(curvePoint(from, ctrl, to, 0)).toEqual(from);
    expect(curvePoint(from, ctrl, to, 1)).toEqual(to);
    expect(curvePoint(from, ctrl, to, 0.5).y).toBeGreaterThan(0);
  });
});

describe("uniquePairs", () => {
  it("drops self-pairs and order-reversed duplicates", () => {
    expect(
      uniquePairs([["a", "b"], ["b", "a"], ["c", "c"], ["b", "c"]]),
    ).toEqual([["a", "b"], ["b", "c"]]);
  });
});

describe("declutterKeep", () => {
  const r = (x: number, y: number, priority = 1) => ({ x, y, w: 100, h: 20, priority });
  it("keeps everything when nothing overlaps", () => {
    expect(declutterKeep([r(0, 0), r(200, 0), r(0, 100)])).toEqual([true, true, true]);
  });
  it("in an overlapping pair only the higher priority survives", () => {
    expect(declutterKeep([r(0, 0, 1), r(40, 5, 2)])).toEqual([false, true]);
  });
  it("a chain collapses to non-touching winners, order-independent", () => {
    const kept = declutterKeep([r(0, 0, 3), r(80, 0, 1), r(160, 0, 2)]);
    expect(kept).toEqual([true, false, true]); // middle loses to both neighbors
  });
});

describe("labelOpacity", () => {
  it("is 1 near, 0 far, smooth between", () => {
    expect(labelOpacity(10, 100, 500)).toBe(1);
    expect(labelOpacity(600, 100, 500)).toBe(0);
    const mid = labelOpacity(300, 100, 500);
    expect(mid).toBeGreaterThan(0.4);
    expect(mid).toBeLessThan(0.6);
  });
});

describe("mock universe", () => {
  it("is deterministic for a given seed", () => {
    expect(mockProjects(NOW, 7)).toEqual(mockProjects(NOW, 7));
  });
  it("covers every stage so the sky has visual variety", () => {
    const stages = new Set(mockProjects(NOW).map((p) => effectiveStage(p, NOW)));
    expect(stages.size).toBeGreaterThanOrEqual(4);
  });
});
