// debug/verification hook — lets tooling drive tiers deterministically
declare global {
  interface Window {
    __yz: {
      list: () => object[];
      enter: (name: string) => void;
      enterVault: (name: string) => void;
      exit: () => void;
      aiSearch: () => void;
      craftCount: () => number;
      stats: () => object;
      supernova: (name: string) => void;
      viewPeople: () => void;
      viewProjects: () => void;
      grantStardust: (n: number) => void;
      customize: () => void;
    };
  }
}
window.__yz = {
  list: () =>
    nodes.map((n) => ({
      name: n.project.name,
      stage: effectiveStage(n.project, NOW),
      dust: isDust(n.project, NOW),
      blackHole: n.project.milestoneMarked,
    })),
  enter: (name: string) => {
    const n = nodes.find((x) => x.project.name === name);
    if (n) enterGalaxy(n);
  },
  enterVault: (name: string) => {
    if (tier.level < 2) return;
    const node = (tier as { focus: GalaxyNode }).focus;
    const layer = layerFor(node);
    const idx = layer.vaults.findIndex((v) => v.name === name);
    if (idx >= 0) enterVault(node, layer, idx);
  },
  exit: exitOneTier,
  aiSearch: () => {
    craft.startAiSearch();
    rewards.celebrate("silent-partner");
  },
  craftCount: () => craft.craftCount,
  stats: () => ({
    scale: scaleName,
    projects: nodes.length,
    totalNotes: projects.reduce((s, p) => s + p.noteCount, 0),
    particles: nodes.reduce((s, n) => s + n.fullCount, 0),
    density: Number(density.toFixed(3)),
    fps: Number(fpsAvg.toFixed(1)),
  }),
  supernova: (name: string) => {
    const n = nodes.find((x) => x.project.name === name);
    if (n && !n.project.milestoneMarked) triggerSupernova(n);
  },
  viewPeople: () => setViewMode("people"),
  viewProjects: () => setViewMode("projects"),
  grantStardust: (n: number) => {
    rewardStore.addStardust(n);
    rewards.refresh();
  },
  customize: toggleCustomize,
};

let lastFrame = performance.now();
let fpsAvg = 60;
let lodFrame = 0;
const wp2 = new THREE.Vector3();

function animate(): void {
  requestAnimationFrame(animate);
  const nowMs = performance.now();
  const dt = Math.min((nowMs - lastFrame) / 1000, 0.05);
  fpsAvg = fpsAvg * 0.96 + (1 / Math.max(nowMs - lastFrame, 1)) * 1000 * 0.04;
  lastFrame = nowMs;

  if (lodFrame % 30 === 0) {
    hud.setTelemetry({
      scale: scaleName,
      bodies: nodes.length,
      notes: projects.reduce((a, p) => a + p.noteCount, 0),
      fps: fpsAvg,
    });
  }
  if (hovered && tier.level === 1 && viewMode === "projects" && !flight) {
    hovered.group.getWorldPosition(wp2);
    hud.lockTo(wp2, hovered.radius, camera);
  } else {
    hud.release();
  }

  // distance LOD is cheap but O(n) — every 6th frame is plenty
  if (++lodFrame % 6 === 0) applyGalaxyLOD(nodes, camera.position);

  if (flight) {
    const t = Math.min((nowMs - flight.start) / flight.ms, 1);
    const e = easeInOut(t);
    camera.position.lerpVectors(flight.from, flight.to, e);
    look.lerpVectors(flight.lookFrom, flight.lookTo, e);
    camera.lookAt(look);
    controls.target.copy(look);
    if (t >= 1) {
      flight = null;
      controls.enabled = true;
    }
  }

  tickStarfield(stars, nowMs / 1000);
  tickStreams(streams, nowMs / 1000);
  craft.update(dt, activeNodes);
  if (nova) shake = nova.update(dt);
  if (shake > 0.01) {
    camera.position.x += (Math.random() - 0.5) * shake;
    camera.position.y += (Math.random() - 0.5) * shake;
    shake *= 0.94;
  }
  for (const n of nodes) {
    if (n.project.id !== frozenGalaxyId) n.group.rotation.y += n.spinSpeed * 0.016;
  }
  if (tier.level === 3) tickNoteSystem(tier.system, dt);

  pick();
  updateFades();

  if (!flight) controls.update();
  composer.render();
  labelRenderer.render(scene, camera);
}

animate();
