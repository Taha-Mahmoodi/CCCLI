// CSS2D overlay for proximity-fade labels
const labelRenderer = new CSS2DRenderer();
labelRenderer.setSize(window.innerWidth, window.innerHeight);
labelRenderer.domElement.style.cssText =
  "position:fixed;top:0;left:0;pointer-events:none;";
document.body.appendChild(labelRenderer.domElement);
window.addEventListener("resize", () =>
  labelRenderer.setSize(window.innerWidth, window.innerHeight),
);

const stars = createStarfield();
scene.add(stars);

const sprite = softSprite();

// ?scale=company renders a real-company-sized universe (the semantic-LOD
// stress test); default stays the 50-project demo sky
const scaleName =
  new URLSearchParams(location.search).get("scale") === "company"
    ? "company"
    : "demo";
const projects = mockProjects(NOW, 7, SCALES[scaleName]);

// global particle budget: aggregate impressions never scale linearly with
// note counts — density thins every galaxy fairly when the sky grows
const PARTICLE_BUDGET = 900_000;
const rawTotal = projects.reduce(
  (s, p) => s + Math.min(2200 + p.noteCount * 10, 14000),
  0,
);
const density = Math.min(1, PARTICLE_BUDGET / rawTotal);

// conquered galaxies carry their owner-chosen visual signature
const signatures = new SignatureStore();
const sigLookup = (projectId: string) => {
  const s = signatures.appliedTo(projectId);
  return { core: s.core, rim: s.rim, accretion: s.accretion };
};

const nodes: GalaxyNode[] = projects.map((p) =>
  buildGalaxy(p, NOW, sprite, density, sigLookup(p.id)),
);
layoutGalaxies(nodes);
nodes.forEach((n) => scene.add(n.group));

// black holes visibly pull matter from their nearest neighbors
const streams = buildInfallStreams(nodes);
streams.forEach((s) => scene.add(s.points));

// by-user view: every teammate's knowledge as a private orb
const orbs: UserOrb[] = mockUsers(projects).map((u) => buildUserOrb(u, sprite));
layoutUserOrbs(orbs);
orbs.forEach((o) => scene.add(o.group));
let viewMode: "projects" | "people" = "projects";

// badges + stardust: the earning moments live at the interaction points
const rewardStore = new RewardStore();
const rewards = new RewardUI(rewardStore);
const hud = new Hud();
let galaxiesEntered = 0;
if (scaleName === "company") rewards.celebrate("cartographer");
window.addEventListener("keydown", (e) => {
  if (e.key === "b" || e.key === "B") rewards.toggleShelf();
});

function setViewMode(mode: "projects" | "people"): void {
  if (mode === viewMode || tier.level !== 1 || flight) return;
  viewMode = mode;
  hidePanel();
  // craft and streams belong to the project sky
  streams.forEach((s) => (s.points.visible = mode === "projects"));
  craft.group.visible = mode === "projects";
  orbs.forEach((o) => (o.group.visible = true));
  if (mode === "people") {
    rewards.celebrate("constellation-of-us");
    flyTo(new THREE.Vector3(0, 210, 430), new THREE.Vector3(0, 0, 0), 2600);
  } else {
    const biggest = nodes.reduce((a, b) => (a.radius > b.radius ? a : b));
    const p = biggest.group.position;
    flyTo(new THREE.Vector3(p.x + 380, p.y + 260, p.z + 380), p.clone(), 2600);
  }
}

window.addEventListener("keydown", (e) => {
  if (e.key === "u" || e.key === "U")
    setViewMode(viewMode === "projects" ? "people" : "projects");
});

// shuttles between active projects + the AI-search vessel
const craft = new CraftLayer(nodes, sprite);
scene.add(craft.group);
const activeNodes = nodes.filter(
  (n) => !isDust(n.project, NOW) && effectiveStage(n.project, NOW) !== "nebula",
);

// galaxy name labels, proximity-faded at tier 1
const galaxyLabels = new Map<string, CSS2DObject>();
for (const n of nodes) {
  const el = document.createElement("div");
  el.className = "yz-label";
  el.textContent = n.project.name;
  const label = new CSS2DObject(el);
  label.position.set(0, n.radius * 0.7 + 4, 0);
  n.group.add(label);
  galaxyLabels.set(n.project.id, label);
}

// --- tier state ---
type Tier =
  | { level: 1 }
  | { level: 2; focus: GalaxyNode }
  | { level: 3; focus: GalaxyNode; system: NoteSystem };
let tier: Tier = { level: 1 };
const vaultLayers = new Map<string, VaultStarLayer>();
const noteSystems = new Map<string, NoteSystem>();
const systemOpacity = new Map<string, number>();
let frozenGalaxyId: string | null = null; // spin pauses while inside a system
let nova: SupernovaEffect | null = null;
let shake = 0;

/** Replace a galaxy node in place, migrating its label and invalidating
 *  cached tier layers. Used by supernova rebirth and signature changes. */
function swapGalaxyNode(idx: number, old: GalaxyNode, reborn: GalaxyNode): void {
  reborn.group.position.copy(old.group.position);
  reborn.group.rotation.copy(old.group.rotation);
  scene.remove(old.group);
  scene.add(reborn.group);
  const label = galaxyLabels.get(old.project.id);
  if (label) {
    old.group.remove(label);
    reborn.group.add(label);
  }
  vaultLayers.delete(old.project.id);
  noteSystems.delete(old.project.id);
  nodes[idx] = reborn;
}

/** The deliberate milestone action: detonate, then reborn as a black hole. */
function triggerSupernova(node: GalaxyNode): void {
  if (nova) return; // one at a time
  const idx = nodes.indexOf(node);
  const p = node.group.position;
  flyTo(
    new THREE.Vector3(p.x + node.radius * 4.2, p.y + node.radius * 1.8, p.z + node.radius * 4.2),
    p.clone(),
    1800,
  );
  nova = new SupernovaEffect(node, sprite);
  scene.add(nova.group);
  nova.onDetonate = () => {
    // what remains is a black hole: rebuild the galaxy with the milestone marked
    node.project.milestoneMarked = true;
    node.project.lastActivity = NOW;
    const reborn = buildGalaxy(node.project, NOW, sprite, density, sigLookup(node.project.id));
    reborn.cloudMat.opacity = 0.0; // fades in via updateFades
    swapGalaxyNode(idx, node, reborn);
    if (nova) nova.onDone = () => {
      nova?.dispose();
      if (nova) scene.remove(nova.group);
      nova = null;
      showPanel(reborn.project, NOW, "galaxy conquered");
      rewards.celebrate("first-light"); // rare: present at the first supernova
      rewards.celebrate("conqueror");
      rewards.bonus(SUPERNOVA_BONUS);
    };
  };
}

function layerFor(node: GalaxyNode): VaultStarLayer {
  let layer = vaultLayers.get(node.project.id);
  if (!layer) {
    layer = buildVaultStars(node.project, NOW, node.radius, sprite);
    node.group.add(layer.group);
    vaultLayers.set(node.project.id, layer);
  }
  return layer;
}

// --- camera flights ---
const easeInOut = (t: number) =>
  t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

interface Flight {
  from: THREE.Vector3;
  to: THREE.Vector3;
  lookFrom: THREE.Vector3;
  lookTo: THREE.Vector3;
  start: number;
  ms: number;
}
let flight: Flight | null = null;
const look = new THREE.Vector3();

function flyTo(to: THREE.Vector3, lookTo: THREE.Vector3, ms: number): void {
  flight = {
    from: camera.position.clone(),
    to,
    lookFrom: controls.target.clone(),
    lookTo,
    start: performance.now(),
    ms,
  };
  controls.enabled = false;
}

// --- tier transitions ---
function enterGalaxy(node: GalaxyNode): void {
  tier = { level: 2, focus: node };
  controls.minDistance = 6;
  layerFor(node).group.visible = true;
  const p = node.group.position;
  flyTo(
    new THREE.Vector3(
      p.x + node.radius * 1.9,
      p.y + node.radius * 0.85,
      p.z + node.radius * 1.9,
    ),
    p.clone(),
    2600,
  );
  showPanel(node.project, NOW, "esc to zoom out");
  renderer.domElement.style.cursor = "default";

  rewards.celebrate("first-flight");
  if (++galaxiesEntered >= 3) rewards.celebrate("wanderer");
  if (isDust(node.project, NOW)) rewards.celebrate("witness");
  if (node.project.milestoneMarked) rewards.celebrate("event-horizon");
}

function enterVault(node: GalaxyNode, layer: VaultStarLayer, idx: number): void {
  frozenGalaxyId = node.project.id; // freeze spin so the system holds still
  node.group.updateMatrixWorld(true);

  const vault = layer.vaults[idx];
  let system = noteSystems.get(vault.id);
  if (!system) {
    const pal = STAGE_PALETTE[effectiveStage(node.project, NOW)];
    system = buildNoteSystem(vault, NOW, pal.core, sprite);
    system.group.position.copy(layer.positions[idx]);
    node.group.add(system.group);
    systemOpacity.set(vault.id, 0);
    noteSystems.set(vault.id, system);
  }
  system.group.visible = true;
  tier = { level: 3, focus: node, system };

  const starWorld = node.group.localToWorld(layer.positions[idx].clone());
  controls.minDistance = 1.2;
  flyTo(
    starWorld.clone().add(new THREE.Vector3(4.2, 2.2, 4.2)),
    starWorld,
    2400,
  );
  showVaultPanel(vault, "esc to zoom out");
  rewards.celebrate("wayfarer");
  setTimeout(() => rewards.celebrate("ground-truth"), 4000);
}

function exitOneTier(): void {
  if (tier.level === 1 && viewMode === "people") {
    setViewMode("projects");
    return;
  }
  if (tier.level === 3) {
    const node = tier.focus;
    frozenGalaxyId = null;
    tier = { level: 2, focus: node };
    controls.minDistance = 6;
    const p = node.group.position;
    flyTo(
      new THREE.Vector3(
        p.x + node.radius * 1.9,
        p.y + node.radius * 0.85,
        p.z + node.radius * 1.9,
      ),
      p.clone(),
      2200,
    );
    showPanel(node.project, NOW, "esc to zoom out");
    return;
  }
  if (tier.level === 2) {
    const from = tier.focus;
    tier = { level: 1 };
    hidePanel();
    controls.minDistance = 18;
    const p = from.group.position;
    flyTo(new THREE.Vector3(p.x + 380, p.y + 260, p.z + 380), p.clone(), 2200);
  }
}

window.addEventListener("keydown", (e) => {
  if (e.key === "Escape") exitOneTier();
});

// --- signature customization (spend stardust on a conquered galaxy) ---
const customEl = document.createElement("div");
customEl.id = "yz-custom";
document.body.appendChild(customEl);

function toggleCustomize(): void {
  if (customEl.classList.contains("yz-custom-open")) {
    customEl.classList.remove("yz-custom-open");
    return;
  }
  if (tier.level !== 2 || !tier.focus.project.milestoneMarked) return;
  const node = tier.focus;
  const current = signatures.appliedTo(node.project.id).id;
  const rows = SIGNATURES.map((s) => {
    const owned = signatures.has(s.id);
    const state = s.id === current ? "applied" : owned ? "owned" : `${s.price} ✦`;
    const hex = `#${s.accretion.toString(16).padStart(6, "0")}`;
    return `
      <div class="yz-sig ${s.id === current ? "yz-sig-current" : ""}" data-sig="${s.id}">
        <span class="yz-badge-dot" style="background:${hex}"></span>
        <div>
          <div class="yz-badge-name">${s.name}</div>
          <div class="yz-badge-desc">${state}</div>
        </div>
      </div>`;
  }).join("");
  customEl.innerHTML = `
    <div class="yz-shelf-title">Signature</div>
    <div class="yz-shelf-sub">${node.project.name} · ${rewardStore.stardust} ✦ stardust</div>
    ${rows}
    <div class="yz-shelf-hint">c to close</div>
  `;
  customEl.classList.add("yz-custom-open");
  customEl.querySelectorAll<HTMLElement>(".yz-sig").forEach((el) => {
    el.onclick = () => {
      const id = el.dataset.sig;
      if (!id || !signatures.buyAndApply(id, node.project.id, rewardStore)) return;
      rewards.refresh();
      const idx = nodes.indexOf(node);
      const reborn = buildGalaxy(
        node.project, NOW, sprite, density, sigLookup(node.project.id),
      );
      reborn.cloudMat.opacity = node.cloudMat.opacity; // no visual pop
      swapGalaxyNode(idx, node, reborn);
      tier = { level: 2, focus: reborn };
      customEl.classList.remove("yz-custom-open");
    };
  });
}

window.addEventListener("keydown", (e) => {
  if (e.key === "c" || e.key === "C") toggleCustomize();
});

// --- picking ---
const raycaster = new THREE.Raycaster();
const pointer = new THREE.Vector2(2, 2); // offscreen until first move
let hovered: GalaxyNode | null = null;
let hoveredVaultIdx = -1;

window.addEventListener("pointermove", (e) => {
  pointer.set(
    (e.clientX / window.innerWidth) * 2 - 1,
    -(e.clientY / window.innerHeight) * 2 + 1,
  );
});
window.addEventListener("click", () => {
  if (flight || viewMode === "people") return; // orbs are private, not enterable
  if (tier.level === 1 && hovered) enterGalaxy(hovered);
  else if (tier.level === 2 && hoveredVaultIdx >= 0)
    enterVault(tier.focus, layerFor(tier.focus), hoveredVaultIdx);
});

let hoveredOrb: UserOrb | null = null;

function pick(): void {
  if (flight || tier.level === 3) {
    hovered = null;
    hoveredVaultIdx = -1;
    return;
  }
  raycaster.setFromCamera(pointer, camera);

  if (viewMode === "people") {
    const hits = raycaster.intersectObjects(
      orbs.map((o) => o.hitSphere),
      false,
    );
    const id = hits[0]?.object.userData.userId as string | undefined;
    const next = id ? orbs.find((o) => o.user.id === id) ?? null : null;
    if (next !== hoveredOrb) {
      hoveredOrb = next;
      if (hoveredOrb) showUserPanel(hoveredOrb.user);
      else hidePanel();
      renderer.domElement.style.cursor = "default";
    }
    return;
  }

  if (tier.level === 1) {
    const hits = raycaster.intersectObjects(
      nodes.map((n) => n.hitSphere),
      false,
    );
    const id = hits[0]?.object.userData.projectId as string | undefined;
    const next = id ? nodes.find((n) => n.project.id === id) ?? null : null;
    if (next !== hovered) {
      hovered = next;
      if (hovered) showPanel(hovered.project, NOW, "click to enter");
      else hidePanel();
      renderer.domElement.style.cursor = hovered ? "pointer" : "default";
    }
    return;
  }

  // tier 2: pick individual vault stars inside the focus galaxy
  const layer = layerFor(tier.focus);
  const hits = raycaster.intersectObjects(layer.hitSpheres, false);
  const vid = hits[0]?.object.userData.vaultId as string | undefined;
  const idx = vid ? layer.vaults.findIndex((v) => v.id === vid) : -1;
  if (idx !== hoveredVaultIdx) {
    hoveredVaultIdx = idx;
    if (idx >= 0) showVaultPanel(layer.vaults[idx], "click to enter");
    else showPanel(tier.focus.project, NOW, "esc to zoom out");
    renderer.domElement.style.cursor = idx >= 0 ? "pointer" : "default";
  }
}

// --- per-frame fades ---
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
const wp = new THREE.Vector3();

function updateFades(): void {
  const level = tier.level;
  const focusId = level >= 2 ? (tier as { focus: GalaxyNode }).focus.project.id : null;
  const focusVaultId = level === 3 ? (tier as { system: NoteSystem }).system.vault.id : null;

  const people = viewMode === "people";
  for (const n of nodes) {
    // non-focus galaxies recede to a dim backdrop (spec: never vanish);
    // inside a system (tier 3) even the focus cloud drops to a whisper;
    // in people view the whole project sky becomes a faint horizon
    const target = people
      ? 0.04
      : focusId === null
        ? 1
        : n.project.id === focusId
          ? level === 3 ? 0.06 : 0.22
          : level === 3 ? 0.04 : 0.1;
    n.cloudMat.opacity = lerp(n.cloudMat.opacity, target, 0.06);
    // nucleus tracks the cloud fade, lifting warmly under the reticle
    const nucleusBase = n.cloudMat.opacity * 0.55;
    const hoverLift = n === hovered && level === 1 && !people ? 0.3 : 0;
    n.nucleusMat.opacity = lerp(n.nucleusMat.opacity, nucleusBase + hoverLift, 0.12);

    const label = galaxyLabels.get(n.project.id)!;
    let op = 0;
    if (focusId === null && !people) {
      n.group.getWorldPosition(wp);
      op = labelOpacity(camera.position.distanceTo(wp), 140, 700);
    }
    const el = label.element as HTMLElement;
      el.style.opacity = op.toFixed(2);
      el.style.display = op < 0.02 ? "none" : "";
  }

  for (const o of orbs) {
    const target = people ? 1 : 0;
    o.mat.opacity = lerp(o.mat.opacity, target, 0.06);
    if (o.mat.opacity < 0.01 && !people) o.group.visible = false;
    let op = 0;
    if (people) {
      o.label.getWorldPosition(wp);
      op = labelOpacity(camera.position.distanceTo(wp), 180, 650) * o.mat.opacity;
    }
    const el = o.label.element as HTMLElement;
    el.style.opacity = op.toFixed(2);
    el.style.display = op < 0.02 ? "none" : "";
  }

  for (const [id, layer] of vaultLayers) {
    const target = id !== focusId ? 0 : level === 3 ? 0.12 : 1;
    layer.starMat.opacity = lerp(layer.starMat.opacity, target, 0.07);
    layer.haloMat.opacity = lerp(layer.haloMat.opacity, target * 0.55, 0.07);
    if (layer.starMat.opacity < 0.01 && id !== focusId) layer.group.visible = false;
    for (const label of layer.labels) {
      let op = 0;
      if (id === focusId && level === 2) {
        label.getWorldPosition(wp);
        op = labelOpacity(camera.position.distanceTo(wp), 26, 90) *
          layer.starMat.opacity;
      }
      const el = label.element as HTMLElement;
      el.style.opacity = op.toFixed(2);
      el.style.display = op < 0.02 ? "none" : "";
    }
  }

  for (const [vid, sys] of noteSystems) {
    const target = vid === focusVaultId ? 1 : 0;
    const cur = lerp(systemOpacity.get(vid) ?? 0, target, 0.08);
    systemOpacity.set(vid, cur);
    sys.setOpacity(cur);
    for (const label of sys.labels) {
      let op = 0;
      if (vid === focusVaultId) {
        label.getWorldPosition(wp);
        op = labelOpacity(camera.position.distanceTo(wp), 3, 16) * cur;
      }
      const el = label.element as HTMLElement;
      el.style.opacity = op.toFixed(2);
      el.style.display = op < 0.02 ? "none" : "";
    }
  }
}

