// Data model + evolution/decay logic. Mirrors the README spec:
// nebula -> red dwarf -> main sequence -> blue giant -> (supernova moment) -> black hole.
// Stages 1-4 derive from sustained cadence + distinct contributors; black hole
// only via an explicit milestone. Decay reverses stages with a visible countdown;
// black holes never revert, they dim to a remnant.

export type Stage =
  | "nebula"
  | "red-dwarf"
  | "main-sequence"
  | "blue-giant"
  | "black-hole";

export interface Project {
  id: string;
  name: string;
  noteCount: number;
  contributors: number;
  /** average activity events per week, sustained */
  cadence: number;
  /** ms epoch of last activity */
  lastActivity: number;
  /** ms epoch of creation */
  createdAt: number;
  /** user explicitly marked the supernova milestone */
  milestoneMarked: boolean;
}

const DAY = 86_400_000;

/** Days of inactivity before each stage cools one step. Visible, never a surprise. */
export const DECAY_DAYS: Record<Exclude<Stage, "nebula" | "black-hole">, number> = {
  "red-dwarf": 21,
  "main-sequence": 14,
  "blue-giant": 12,
};

/** Earned stage from sustained activity, before decay is applied. */
export function earnedStage(p: Project): Stage {
  if (p.milestoneMarked) return "black-hole";
  const ageWeeks = Math.max(1, (p.lastActivity - p.createdAt) / (7 * DAY));
  // cadence-over-time and breadth of contributors, not raw volume
  const score = Math.min(p.cadence, 40) * Math.min(ageWeeks, 26) + p.contributors * 18;
  if (score >= 260) return "blue-giant";
  if (score >= 90) return "main-sequence";
  if (score >= 18) return "red-dwarf";
  return "nebula";
}

const ORDER: Stage[] = ["nebula", "red-dwarf", "main-sequence", "blue-giant"];

/** Stage after decay. Black holes never revert (they dim via remnantFactor). */
export function effectiveStage(p: Project, now: number): Stage {
  const earned = earnedStage(p);
  if (earned === "black-hole") return "black-hole";
  let idx = ORDER.indexOf(earned);
  let idle = (now - p.lastActivity) / DAY;
  while (idx > 0) {
    const window = DECAY_DAYS[ORDER[idx] as keyof typeof DECAY_DAYS];
    if (idle < window) break;
    idle -= window;
    idx--;
  }
  return ORDER[idx];
}

/** Days until the next cooling step, or null if not decaying (nebula / black hole). */
export function decayCountdown(p: Project, now: number): number | null {
  const stage = effectiveStage(p, now);
  if (stage === "nebula" || stage === "black-hole") return null;
  const earnedIdx = ORDER.indexOf(earnedStage(p));
  const stageIdx = ORDER.indexOf(stage);
  let idle = (now - p.lastActivity) / DAY;
  for (let i = earnedIdx; i > stageIdx; i--) {
    idle -= DECAY_DAYS[ORDER[i] as keyof typeof DECAY_DAYS];
  }
  const window = DECAY_DAYS[stage as keyof typeof DECAY_DAYS];
  return Math.max(0, window - idle);
}

/** Terminal neglect: a project that sat at (or fell to) nebula and kept
 *  idling collapses into a dust cloud — the state you have to work back
 *  up from, per the vision. Black holes never dust (they dim to remnants). */
export const DUST_IDLE_DAYS = 60;

export function isDust(p: Project, now: number): boolean {
  if (earnedStage(p) === "black-hole") return false;
  const idleDays = (now - p.lastActivity) / DAY;
  return effectiveStage(p, now) === "nebula" && idleDays > DUST_IDLE_DAYS;
}

/** 1 = fully lit black hole; approaches 0.25 as a neglected remnant. Non-black-holes: 1. */
export function remnantFactor(p: Project, now: number): number {
  if (earnedStage(p) !== "black-hole") return 1;
  const idleDays = (now - p.lastActivity) / DAY;
  return Math.max(0.25, 1 - idleDays / 60);
}

// --- deterministic mock universe (until Chapters feeds real data) ---

export function mulberry32(seed: number): () => number {
  let a = seed >>> 0;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

// --- vaults (tier-2: stars inside a project galaxy) ---

export interface Vault {
  id: string;
  name: string;
  noteCount: number;
  lastActivity: number;
}

const VAULT_NAMES = [
  "Design", "Research", "Specs", "Meetings", "Roadmap", "Archive", "Ideas",
  "Ops", "Field Notes", "Experiments", "Reviews", "Playbook", "Interviews",
  "Backlog", "Releases", "Drafts", "Decisions", "Postmortems",
];

/** Deterministic vaults for a project; note counts sum exactly to p.noteCount. */
export function mockVaults(p: Project): Vault[] {
  const rnd = mulberry32(p.id.length * 2711 + p.noteCount * 13);
  const count = Math.max(2, Math.min(16, Math.round(2 + Math.sqrt(p.noteCount) / 2.2)));
  const weights = Array.from({ length: count }, () => 0.15 + rnd());
  const total = weights.reduce((a, b) => a + b, 0);
  let assigned = 0;
  return weights.map((w, i) => {
    const last = i === count - 1;
    const notes = last
      ? p.noteCount - assigned
      : Math.max(1, Math.round((w / total) * p.noteCount));
    assigned += notes;
    return {
      id: `${p.id}v${i}`,
      name: VAULT_NAMES[i % VAULT_NAMES.length],
      noteCount: Math.max(1, notes),
      lastActivity: p.lastActivity - rnd() * 20 * DAY,
    };
  });
}

// --- notes (tier-3: planets orbiting a vault star) ---

export interface Note {
  id: string;
  title: string;
  /** proxy for how much content the note holds (drives planet size) */
  size: number;
  lastActivity: number;
  /** sub-notes/comments — rendered as moons */
  subCount: number;
}

const NOTE_TITLES = [
  "Kickoff", "API sketch", "User interviews", "Pricing", "Launch plan",
  "Retro", "Benchmarks", "Edge cases", "Migration", "Onboarding",
  "Metrics", "Incident log", "Roadmap v2", "Naming", "Access model",
  "Sync design", "Search notes", "Perf audit", "Beta feedback", "Deck",
];

/** Deterministic notes for a vault. Capped for tier-3 readability. */
export function mockNotes(v: Vault): Note[] {
  const rnd = mulberry32(v.id.length * 6133 + v.noteCount * 29);
  const count = Math.min(v.noteCount, 14);
  return Array.from({ length: count }, (_, i) => ({
    id: `${v.id}n${i}`,
    title: NOTE_TITLES[i % NOTE_TITLES.length],
    size: 1 + Math.floor(rnd() * 9),
    lastActivity: v.lastActivity - rnd() * 90 * DAY,
    subCount: rnd() < 0.4 ? 1 + Math.floor(rnd() * 3) : 0,
  }));
}

/** Fresh notes orbit close; stale notes drift outward. Pure, testable. */
export function noteOrbitRadius(note: Note, now: number, min = 0.8, max = 3.2): number {
  const idleDays = Math.max(0, (now - note.lastActivity) / DAY);
  const t = Math.min(idleDays / 120, 1);
  return min + (max - min) * t;
}

/** 1 near the camera -> 0 far away; smoothstep between. Pure, testable. */
export function labelOpacity(dist: number, near: number, far: number): number {
  if (dist <= near) return 1;
  if (dist >= far) return 0;
  const t = (dist - near) / (far - near);
  return 1 - t * t * (3 - 2 * t);
}

const NAMES = [
  "Atlas", "Chapters", "Heard", "Commons", "Orchid", "Beacon", "Ledger",
  "Compass", "Relay", "Anchor", "Prism", "Meridian", "Harbor", "Signal",
  "Quarry", "Lattice", "Ember", "Drift", "Vantage", "Cinder", "Halcyon",
  "Bellwether", "Foundry", "Aperture", "Tessera", "Vireo", "Cobalt",
  "Damson", "Elm", "Fathom", "Garnet", "Hollis", "Iris", "Juniper",
  "Kestrel", "Loess", "Mica", "Nadir", "Onyx", "Pumice", "Quill", "Rune",
  "Sable", "Tarn", "Umber", "Verge", "Wren", "Xylem", "Yarrow", "Zenith",
];

export function mockProjects(now: number, seed = 7): Project[] {
  const rnd = mulberry32(seed);
  return NAMES.map((name, i) => {
    const ageDays = 30 + rnd() * 700;
    // ~1 in 5 projects are neglected, some long enough to decay fully to dust
    const idleDays = rnd() < 0.22 ? rnd() * 130 : rnd() * 6;
    const cadence = rnd() * 38;
    return {
      id: `p${i}`,
      name,
      noteCount: Math.floor(8 + rnd() * 900),
      contributors: 1 + Math.floor(rnd() * 9),
      cadence,
      createdAt: now - ageDays * DAY,
      lastActivity: now - idleDays * DAY,
      milestoneMarked: rnd() < 0.08 && cadence > 20,
    };
  });
}
