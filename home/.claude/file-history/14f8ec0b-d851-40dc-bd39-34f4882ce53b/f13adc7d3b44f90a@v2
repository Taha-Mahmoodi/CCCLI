/**
 * Third Eye Kit — Node C: Manual/Tactile Scanning (Gloves)
 *
 * Near-field obstacle detection for hand-guided exploration.
 * Feedback: Low-intensity haptic.
 * Status: [IN DEV] — Glove enclosure not yet fabricated.
 *
 * Platform: Arduino Mini Pro (3.3V)
 * Sensor: 1 × HC-SR04 Ultrasonic
 * Actuator: 1 × Vibration motor
 */

#define TRIG_PIN      9
#define ECHO_PIN      10
#define HAPTIC_PIN    5

// Near-field range (arm's reach)
#define ALERT_CM      40   // cm — detect objects within arm's reach

float getDistance(int trigPin, int echoPin);

void setup() {
  Serial.begin(9600);
  pinMode(TRIG_PIN, OUTPUT);
  pinMode(ECHO_PIN, INPUT);
  pinMode(HAPTIC_PIN, OUTPUT);

  Serial.println("Node C: Manual/Tactile Scanning [IN DEV]");
  Serial.println("Glove enclosure design pending.");
}

void loop() {
  float distance = getDistance(TRIG_PIN, ECHO_PIN);

  if (distance > 0 && distance < ALERT_CM) {
    // Low-intensity haptic pulse
    digitalWrite(HAPTIC_PIN, HIGH);
    delayMicroseconds(50);  // Very short pulse for subtle feedback
    digitalWrite(HAPTIC_PIN, LOW);

    Serial.print("Object at ");
    Serial.print(distance);
    Serial.println(" cm (hand range)");
  }

  delay(50);  // Higher sample rate for hand-guided exploration
}

float getDistance(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  long pulseDuration = pulseIn(echoPin, HIGH, 30000);

  if (pulseDuration == 0) {
    return -1;
  }

  float distance = pulseDuration / 58.0;

  if (distance < 2 || distance > 400) {
    return -1;
  }

  return distance;
}
