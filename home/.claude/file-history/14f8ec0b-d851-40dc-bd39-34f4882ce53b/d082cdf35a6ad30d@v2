/**
 * initializeGSM() — Power on and configure GSM module
 */
void initializeGSM() {
  // Toggle power pin (at least 1 second)
  digitalWrite(GSM_KEY_PIN, HIGH);
  delay(1000);
  digitalWrite(GSM_KEY_PIN, LOW);

  delay(2000);  // Wait for module to boot

  // Check if module responds
  sendAT("AT");
  // Expected: "OK"

  // Disable command echo
  sendAT("ATE0");

  // Set SMS text mode
  sendAT("AT+CMGF=1");

  Serial.println("GSM module initialized.");
}

