/**
 * sendLocationSMS() — Send GPS coordinates via SMS
 */
void sendLocationSMS(const char* phoneNumber, float lat, float lon) {
  // Compose SMS with coordinates
  String message = "Location: ";
  message += lat;
  message += ",";
  message += lon;

  // Send SMS command
  String command = "AT+CMGS=\"";
  command += phoneNumber;
  command += "\"";

  sendAT(command);
  // Send message content followed by Ctrl+Z (0x1A)
  gsmSerial.print(message);
  gsmSerial.write(0x1A);

  Serial.print("Location sent to ");
  Serial.println(phoneNumber);
}

/**
 * sendAT() — Send AT command and read response
 */
void sendAT(const char* command) {
  gsmSerial.println(command);

  // Wait for response (simplified; real implementation has timeout)
  delay(500);

  // Read response
  while (gsmSerial.available()) {
    Serial.write(gsmSerial.read());
  }
}

