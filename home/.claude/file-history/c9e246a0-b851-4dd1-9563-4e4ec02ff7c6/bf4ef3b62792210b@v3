@import "tailwindcss";

/*
  Third Eye World design tokens.
  Base: cool near-neutral (zinc). Accent: a jade "signal" green anchored on the
  real haptic-body-map schematic (#1D9E75) so the site and the diagrams cohere.
  One theme, both light and dark. Text scale + contrast are user-tunable knobs
  (wired to the accessibility control center in the Commons app).
*/

:root {
  --bg: #f7f8f8;
  --surface: #ffffff;
  --surface-2: #f0f1f2;
  --fg: #18181b;
  --muted: #52525b;
  --border: #e2e4e7;
  --accent: #0d7a57;
  --accent-strong: #0a6247;
  --accent-fg: #ffffff;
  --signal: #12a074;

  --text-scale: 1;
}

@media (prefers-color-scheme: dark) {
  :root {
    --bg: #09090b;
    --surface: #101013;
    --surface-2: #17171b;
    --fg: #f4f4f5;
    --muted: #a1a1aa;
    --border: #27272a;
    --accent: #2fd39f;
    --accent-strong: #4ce0b0;
    --accent-fg: #04130d;
    --signal: #2fd39f;
  }
}

/* Explicit theme override (for a future toggle and for verification) */
:root[data-theme="dark"] {
  --bg: #09090b;
  --surface: #101013;
  --surface-2: #17171b;
  --fg: #f4f4f5;
  --muted: #a1a1aa;
  --border: #27272a;
  --accent: #2fd39f;
  --accent-strong: #4ce0b0;
  --accent-fg: #04130d;
  --signal: #2fd39f;
}

/* High-contrast mode (toggled from the a11y control center) */
:root[data-contrast="high"] {
  --muted: #2a2a2e;
  --border: #71717a;
}
@media (prefers-color-scheme: dark) {
  :root[data-contrast="high"] {
    --muted: #e4e4e7;
    --border: #a1a1aa;
  }
}

@theme inline {
  --color-bg: var(--bg);
  --color-surface: var(--surface);
  --color-surface-2: var(--surface-2);
  --color-fg: var(--fg);
  --color-muted: var(--muted);
  --color-border: var(--border);
  --color-accent: var(--accent);
  --color-accent-strong: var(--accent-strong);
  --color-accent-fg: var(--accent-fg);
  --color-signal: var(--signal);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

html {
  font-size: calc(100% * var(--text-scale, 1));
}

body {
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-sans), system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}

::selection {
  background: color-mix(in oklab, var(--accent) 30%, transparent);
}

/* --- Accessibility primitives --- */

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

.skip-link {
  position: absolute;
  left: 0.5rem;
  top: -3rem;
  z-index: 100;
  padding: 0.5rem 0.75rem;
  background: var(--fg);
  color: var(--bg);
  border-radius: 0.375rem;
  transition: top 0.15s ease;
}
.skip-link:focus {
  top: 0.5rem;
}

/* Visible focus for keyboard users everywhere */
:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
  border-radius: 2px;
}

/*
  Scroll reveal. Content is visible by default so it survives no-JS, crawlers,
  and reduced motion. Only when JS is present AND motion is allowed do elements
  start hidden and rise into view. The `.js` class is set before first paint,
  so there is no flash of the pre-hidden state.
*/
@media (prefers-reduced-motion: no-preference) {
  :root.js .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  :root.js .reveal.is-visible {
    opacity: 1;
    transform: none;
  }
}

/* Respect the OS reduced-motion preference by default... */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
    scroll-behavior: auto !important;
  }
}

/* ...and honor the user's own toggle from the accessibility control center. */
:root[data-reduced-motion="true"] *,
:root[data-reduced-motion="true"] *::before,
:root[data-reduced-motion="true"] *::after {
  animation-duration: 0.001ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.001ms !important;
  scroll-behavior: auto !important;
}
