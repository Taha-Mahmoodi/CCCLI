import { requireUser } from "@/lib/auth";
import { prisma } from "@/lib/db";
import { ContributorForm } from "@/components/app/contributor-form";

export const metadata = { title: "Contribute" };

export default async function ContributePage() {
  const user = await requireUser();
  const interest = await prisma.contributorInterest.findUnique({
    where: { userId: user.id },
  });

  return (
    <div className="mx-auto max-w-2xl px-5 py-12">
      <h1 className="text-2xl font-semibold tracking-tight">Contribute</h1>
      <p className="mt-2 text-muted">
        Third Eye needs engineers across hardware, sensing, and software. Tell us
        where you can help and we will reach out with real work.
      </p>

      <ContributorForm
        initial={
          interest
            ? {
                githubUrl: interest.githubUrl ?? "",
                focusAreas: interest.focusAreas,
                note: interest.note ?? "",
              }
            : null
        }
      />
    </div>
  );
}
