import Link from "next/link";
import { auth } from "@/lib/auth";
import { prisma } from "@/lib/db";

const CARDS = [
  {
    href: "/app/feed",
    title: "Updates",
    body: "Follow the build, one honest post at a time.",
  },
  {
    href: "/app/waitlist",
    title: "Pilot waitlist",
    body: "Put your hand up to try Third Eye early.",
  },
  {
    href: "/app/contribute",
    title: "Contribute",
    body: "Engineers: tell us where you can help.",
  },
  {
    href: "/app/dossier",
    title: "The dossier",
    body: "Read the full vision and the safety rules.",
  },
  {
    href: "/app/profile",
    title: "Profile and access",
    body: "Your details and accessibility controls.",
  },
];

export default async function CommonsHome() {
  const session = await auth();
  const profile = await prisma.profile.findUnique({
    where: { userId: session!.user.id },
    select: { displayName: true },
  });
  const name = profile?.displayName ?? "friend";

  return (
    <div className="mx-auto max-w-5xl px-5 py-12">
      <h1 className="text-2xl font-semibold tracking-tight">
        Welcome to Third Eye Commons
      </h1>
      <p className="mt-2 text-muted">Good to have you here, {name}.</p>

      <div className="mt-8 grid gap-4 sm:grid-cols-2">
        {CARDS.map((c) => (
          <Link
            key={c.href}
            href={c.href}
            className="rounded-2xl border border-border bg-surface p-5 transition-colors hover:border-accent/60"
          >
            <h2 className="font-semibold text-fg">{c.title}</h2>
            <p className="mt-1 text-sm text-muted">{c.body}</p>
          </Link>
        ))}
      </div>
    </div>
  );
}
