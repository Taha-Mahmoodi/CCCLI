generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  BLIND_TRAVELER
  FAMILY
  CLINICIAN
  ENGINEER
  SUPPORTER
}

enum WaitStatus {
  PENDING
  CONTACTED
  ENROLLED
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  passwordHash    String
  role            Role
  emailVerifiedAt DateTime?
  createdAt       DateTime             @default(now())
  profile         Profile?
  reactions       Reaction[]
  waitlist        WaitlistEntry?
  contributor     ContributorInterest?
  updates         Update[]
}

model Profile {
  userId      String @id
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  bio         String?
  region      String?
  // { reducedMotion: boolean, highContrast: boolean, textScale: number }
  a11yPrefs   Json   @default("{\"reducedMotion\":false,\"highContrast\":false,\"textScale\":1}")
}

model Update {
  id          String     @id @default(cuid())
  authorId    String?
  author      User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title       String
  body        String
  publishedAt DateTime   @default(now())
  reactions   Reaction[]
}

model Reaction {
  id       String @id @default(cuid())
  updateId String
  update   Update @relation(fields: [updateId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind     String

  @@unique([updateId, userId])
}

model WaitlistEntry {
  id            String     @id @default(cuid())
  userId        String     @unique
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role
  region        String?
  deviceContext String?
  status        WaitStatus @default(PENDING)
  createdAt     DateTime   @default(now())
}

model ContributorInterest {
  id         String   @id @default(cuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUrl  String?
  focusAreas String[]
  note       String?
  createdAt  DateTime @default(now())
}
