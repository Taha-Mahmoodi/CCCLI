"use client";

import Link from "next/link";
import { usePathname } from "next/navigation";
import { Bell } from "@phosphor-icons/react";
import { signOutAction } from "@/actions/session";

const LINKS = [
  { href: "/app", label: "Community" },
  { href: "/app/feed", label: "Updates" },
  { href: "/app/waitlist", label: "Pilot waitlist" },
  { href: "/app/contribute", label: "Contribute" },
  { href: "/app/dossier", label: "Dossier" },
];

function isActive(pathname: string, href: string) {
  return href === "/app" ? pathname === "/app" : pathname.startsWith(href);
}

export function AppNav({ unreadCount = 0 }: { unreadCount?: number }) {
  const pathname = usePathname();
  const badge = unreadCount > 9 ? "9+" : String(unreadCount);

  return (
    <header className="sticky top-0 z-50 border-b border-border bg-bg/80 backdrop-blur-md">
      <nav
        aria-label="Commons"
        className="mx-auto flex h-16 max-w-5xl items-center gap-3 px-5"
      >
        <Link href="/app" className="font-semibold tracking-tight">
          Third Eye <span className="font-normal text-muted">Commons</span>
        </Link>

        <ul className="ml-4 hidden items-center gap-1 md:flex">
          {LINKS.map((l) => {
            const active = isActive(pathname, l.href);
            return (
              <li key={l.href}>
                <Link
                  href={l.href}
                  aria-current={active ? "page" : undefined}
                  className={`rounded-md px-3 py-1.5 text-sm transition-colors ${
                    active ? "bg-surface-2 text-fg" : "text-muted hover:text-fg"
                  }`}
                >
                  {l.label}
                </Link>
              </li>
            );
          })}
        </ul>

        <div className="ml-auto flex items-center gap-2">
          <Link
            href="/app/notifications"
            aria-current={
              isActive(pathname, "/app/notifications") ? "page" : undefined
            }
            aria-label={
              unreadCount > 0
                ? `Notifications, ${unreadCount} unread`
                : "Notifications"
            }
            className={`relative rounded-md p-2 transition-colors ${
              isActive(pathname, "/app/notifications")
                ? "bg-surface-2 text-fg"
                : "text-muted hover:text-fg"
            }`}
          >
            <Bell size={20} aria-hidden />
            {unreadCount > 0 ? (
              <span
                aria-hidden
                className="absolute -right-0.5 -top-0.5 min-w-[1.1rem] rounded-full bg-accent px-1 text-center text-[10px] font-semibold leading-4 text-accent-fg"
              >
                {badge}
              </span>
            ) : null}
          </Link>

          <Link
            href="/app/profile"
            aria-current={isActive(pathname, "/app/profile") ? "page" : undefined}
            className={`hidden rounded-md px-3 py-1.5 text-sm transition-colors sm:block ${
              isActive(pathname, "/app/profile")
                ? "bg-surface-2 text-fg"
                : "text-muted hover:text-fg"
            }`}
          >
            Profile
          </Link>

          <form action={signOutAction}>
            <button
              type="submit"
              className="rounded-md border border-border px-3 py-1.5 text-sm text-muted transition-colors hover:text-fg"
            >
              Sign out
            </button>
          </form>
        </div>
      </nav>

      {/* Mobile: horizontally scrollable link row */}
      <div className="border-t border-border md:hidden">
        <ul className="flex gap-1 overflow-x-auto px-3 py-2 text-sm">
          {[...LINKS, { href: "/app/profile", label: "Profile" }].map((l) => {
            const active = isActive(pathname, l.href);
            return (
              <li key={l.href}>
                <Link
                  href={l.href}
                  aria-current={active ? "page" : undefined}
                  className={`block whitespace-nowrap rounded-md px-3 py-1.5 ${
                    active ? "bg-surface-2 text-fg" : "text-muted"
                  }`}
                >
                  {l.label}
                </Link>
              </li>
            );
          })}
        </ul>
      </div>
    </header>
  );
}
