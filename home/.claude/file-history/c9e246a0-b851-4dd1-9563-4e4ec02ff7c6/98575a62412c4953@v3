name: CI

on:
  # Run on every PR regardless of base, so stacked feature PRs are also checked.
  pull_request:
  push:
    branches: [dev, prod, main]

env:
  # Non-secret CI placeholder; real deployments set their own AUTH_SECRET.
  AUTH_SECRET: ci-not-a-real-secret-please-override-000000

jobs:
  quality:
    name: Type-check, lint, unit, build
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npx prisma generate
      - run: npm run type-check
      - run: npm run lint
      - run: npm test
      - run: npm run build

  e2e:
    name: End-to-end (Playwright)
    runs-on: ubuntu-latest
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: third_eye
          POSTGRES_PASSWORD: third_eye
          POSTGRES_DB: third_eye
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U third_eye"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10
    env:
      DATABASE_URL: postgresql://third_eye:third_eye@localhost:5432/third_eye?schema=public
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci
      - run: npx prisma generate
      - run: npx prisma migrate deploy
      - run: npx prisma db seed
      - run: npx playwright install --with-deps chromium
      - run: npm run test:e2e
