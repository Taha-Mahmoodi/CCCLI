/**
 * Short relative time ("now", "5m", "3h", "2d") for recent items, falling back
 * to an absolute date for anything older than a week. Pure + testable.
 */
export function relativeTime(from: Date, now: Date = new Date()): string {
  const secs = Math.round((now.getTime() - from.getTime()) / 1000);
  if (secs < 45) return "now";
  const mins = Math.round(secs / 60);
  if (mins < 60) return `${mins}m`;
  const hours = Math.round(mins / 60);
  if (hours < 24) return `${hours}h`;
  const days = Math.round(hours / 24);
  if (days < 7) return `${days}d`;
  return from.toLocaleDateString("en-US", {
    year: from.getFullYear() === now.getFullYear() ? undefined : "numeric",
    month: "short",
    day: "numeric",
  });
}
