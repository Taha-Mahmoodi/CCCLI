import { test, expect, type Page } from "@playwright/test";
import AxeBuilder from "@axe-core/playwright";

const TAGS = ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa"];

async function axeHere(page: Page, label: string) {
  const results = await new AxeBuilder({ page }).withTags(TAGS).analyze();
  const found = results.violations.filter(
    (v) => v.impact === "serious" || v.impact === "critical",
  );
  expect(
    found,
    `${label}: ${JSON.stringify(
      found.map((v) => ({ id: v.id, help: v.help })),
      null,
      2,
    )}`,
  ).toEqual([]);
}

async function axeClean(page: Page, path: string) {
  await page.goto(path);
  await axeHere(page, path);
}

test("Commons pages have no serious or critical a11y violations", async ({
  page,
}) => {
  await page.emulateMedia({ reducedMotion: "reduce" });

  // sign in first
  await page.goto("/app/signup");
  await page.getByLabel("Name").fill("Ada Traveler");
  await page.getByLabel("Email").fill(`a11y-${Date.now()}@example.com`);
  await page.getByLabel("Password").fill("test-password-123");
  await page.getByLabel("I am a").selectOption("CLINICIAN");
  await page.getByRole("button", { name: /create account/i }).click();
  await expect(page).toHaveURL(/\/app$/);

  // Mission surfaces
  await axeClean(page, "/app/feed");
  await axeClean(page, "/app/profile");
  await axeClean(page, "/app/waitlist");
  await axeClean(page, "/app/contribute");
  await axeClean(page, "/app/dossier");

  // Social surfaces
  await axeClean(page, "/app");
  await axeClean(page, "/app/notifications");

  // Post detail + a member profile (need real content, so create a post first)
  await page.goto("/app");
  await page
    .getByLabel(/share something with the community/i)
    .fill("Accessibility check post");
  await page.getByRole("button", { name: /^post$/i }).click();

  const article = page.locator("article", {
    hasText: "Accessibility check post",
  });
  await article.getByRole("link", { name: /open the discussion/i }).click();
  await expect(page).toHaveURL(/\/app\/post\//);
  await axeHere(page, "/app/post/[id]");

  await page.goto("/app");
  await page
    .locator("article", { hasText: "Accessibility check post" })
    .getByRole("link", { name: "Ada Traveler" })
    .click();
  await expect(page).toHaveURL(/\/app\/u\//);
  await axeHere(page, "/app/u/[id]");
});
