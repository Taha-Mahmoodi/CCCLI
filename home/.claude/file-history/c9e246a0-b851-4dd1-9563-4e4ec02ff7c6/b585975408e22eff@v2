import { notFound } from "next/navigation";
import { requireUser } from "@/lib/auth";
import { prisma } from "@/lib/db";
import { PostCard, type FeedPost } from "@/components/app/post-card";
import { FollowButton } from "@/components/app/follow-button";
import { ROLE_LABELS, type RoleValue } from "@/lib/validation";

export const metadata = { title: "Member" };

export default async function MemberProfile({
  params,
}: {
  params: Promise<{ id: string }>;
}) {
  const { id } = await params;
  const me = await requireUser();

  const member = await prisma.user.findUnique({
    where: { id },
    select: {
      id: true,
      role: true,
      profile: { select: { displayName: true, bio: true, region: true } },
      _count: { select: { followers: true, following: true, posts: true } },
      posts: {
        orderBy: { createdAt: "desc" },
        take: 50,
        include: {
          _count: { select: { likes: true, comments: true } },
          likes: { where: { userId: me.id }, select: { id: true } },
        },
      },
    },
  });
  if (!member) notFound();

  const isSelf = member.id === me.id;
  const iFollow = isSelf
    ? false
    : (await prisma.follow.findUnique({
        where: {
          followerId_followingId: { followerId: me.id, followingId: member.id },
        },
        select: { id: true },
      })) !== null;

  const name = member.profile?.displayName ?? "Member";
  const feed: FeedPost[] = member.posts.map((p) => ({
    id: p.id,
    body: p.body,
    createdAt: p.createdAt,
    author: { id: member.id, displayName: name },
    likeCount: p._count.likes,
    commentCount: p._count.comments,
    liked: p.likes.length > 0,
  }));

  return (
    <div className="mx-auto max-w-2xl px-5 py-10">
      <header className="rounded-2xl border border-border bg-surface p-6">
        <div className="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 className="text-2xl font-semibold tracking-tight">{name}</h1>
            <p className="mt-1 text-sm text-muted">
              {ROLE_LABELS[member.role as RoleValue]}
              {member.profile?.region ? ` · ${member.profile.region}` : ""}
            </p>
          </div>
          {!isSelf ? (
            <FollowButton targetId={member.id} initialFollowing={iFollow} />
          ) : null}
        </div>

        <p className="mt-4 flex gap-4 text-sm text-muted">
          <span>
            <span className="font-semibold text-fg">
              {member._count.followers}
            </span>{" "}
            followers
          </span>
          <span>
            <span className="font-semibold text-fg">
              {member._count.following}
            </span>{" "}
            following
          </span>
          <span>
            <span className="font-semibold text-fg">{member._count.posts}</span>{" "}
            posts
          </span>
        </p>

        {member.profile?.bio ? (
          <p className="mt-4 leading-relaxed text-fg">{member.profile.bio}</p>
        ) : null}
      </header>

      <h2 className="mt-8 text-lg font-semibold">
        {isSelf ? "Your posts" : "Posts"}
      </h2>
      {feed.length === 0 ? (
        <p className="mt-4 rounded-2xl border border-border bg-surface p-6 text-muted">
          No posts yet.
        </p>
      ) : (
        <ul className="mt-4 flex flex-col gap-4">
          {feed.map((p) => (
            <li key={p.id}>
              <PostCard post={p} />
            </li>
          ))}
        </ul>
      )}
    </div>
  );
}
