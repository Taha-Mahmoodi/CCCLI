import { describe, it, expect } from "vitest";
import { postSchema, commentSchema, POST_MAX } from "@/lib/validation";
import { relativeTime } from "@/lib/time";

describe("post validation", () => {
  it("rejects empty or whitespace-only posts", () => {
    expect(postSchema.safeParse({ body: "   " }).success).toBe(false);
  });
  it("accepts a normal post and trims it", () => {
    const r = postSchema.safeParse({ body: "  A route that worked.  " });
    expect(r.success).toBe(true);
    if (r.success) expect(r.data.body).toBe("A route that worked.");
  });
  it("rejects posts over the limit", () => {
    expect(postSchema.safeParse({ body: "x".repeat(POST_MAX + 1) }).success).toBe(
      false,
    );
  });
});

describe("comment validation", () => {
  it("rejects empty comments", () => {
    expect(commentSchema.safeParse({ body: "" }).success).toBe(false);
  });
  it("accepts a reply", () => {
    expect(commentSchema.safeParse({ body: "Thanks!" }).success).toBe(true);
  });
});

describe("relativeTime", () => {
  const now = new Date("2026-07-14T12:00:00Z");
  it("says now for a few seconds ago", () => {
    expect(relativeTime(new Date("2026-07-14T11:59:40Z"), now)).toBe("now");
  });
  it("renders minutes", () => {
    expect(relativeTime(new Date("2026-07-14T11:30:00Z"), now)).toBe("30m");
  });
  it("renders hours", () => {
    expect(relativeTime(new Date("2026-07-14T09:00:00Z"), now)).toBe("3h");
  });
  it("renders days", () => {
    expect(relativeTime(new Date("2026-07-12T12:00:00Z"), now)).toBe("2d");
  });
  it("falls back to an absolute date past a week", () => {
    expect(relativeTime(new Date("2026-06-01T12:00:00Z"), now)).toMatch(/Jun/);
  });
});
