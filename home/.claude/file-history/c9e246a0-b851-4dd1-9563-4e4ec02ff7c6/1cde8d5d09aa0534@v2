import { describe, it, expect } from "vitest";
import { hashPassword, verifyPassword } from "@/lib/auth-password";

describe("password hashing", () => {
  it("does not store the plaintext", async () => {
    const digest = await hashPassword("correct horse battery staple");
    expect(digest).not.toBe("correct horse battery staple");
    expect(digest.length).toBeGreaterThan(20);
  });

  it("verifies the correct password", async () => {
    const digest = await hashPassword("s3cret-passw0rd");
    expect(await verifyPassword("s3cret-passw0rd", digest)).toBe(true);
  });

  it("rejects the wrong password", async () => {
    const digest = await hashPassword("s3cret-passw0rd");
    expect(await verifyPassword("not-the-password", digest)).toBe(false);
  });
});
