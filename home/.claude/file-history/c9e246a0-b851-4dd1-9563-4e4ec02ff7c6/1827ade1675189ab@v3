import { test, expect } from "@playwright/test";

test("sign up, sign out, then sign back in", async ({ page }) => {
  const email = `user-${Date.now()}@example.com`;
  const password = "test-password-123";

  // Sign up
  await page.goto("/app/signup");
  await page.getByLabel("Name").fill("Test User");
  await page.getByLabel("Email").fill(email);
  await page.getByLabel("Password").fill(password);
  await page.getByLabel("I am a").selectOption("BLIND_TRAVELER");
  await page.getByRole("button", { name: /create account/i }).click();

  await expect(page).toHaveURL(/\/app$/);
  await expect(
    page.getByRole("heading", { name: "Community", level: 1 }),
  ).toBeVisible();

  // Sign out
  await page.getByRole("button", { name: /sign out/i }).click();
  await expect(page).toHaveURL(/\/app\/login$/);

  // Sign back in
  await page.getByLabel("Email").fill(email);
  await page.getByLabel("Password").fill(password);
  await page.getByRole("button", { name: /^sign in$/i }).click();
  await expect(page).toHaveURL(/\/app$/);
});

test("unauthenticated visit to /app redirects to login", async ({ page }) => {
  await page.goto("/app");
  await expect(page).toHaveURL(/\/app\/login$/);
});
